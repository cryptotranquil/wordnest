      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  :root{\n    --cream:#fff8e7; --bevel:#d7c199; --teal:#0f766e; --teal-lift:#9ff3e8; --gold:#f5b83d;\n    --text:#e7f2f3; --muted:#94aaa8; --glass:rgba(13,32,36,.56); --glass-line:rgba(255,255,255,.15);\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif; --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);color:var(--text);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px}\n  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,17,22,.84) 0%,rgba(6,24,29,.26) 20%,rgba(5,22,26,.4) 54%,rgba(4,15,20,.9) 90%)}\n  .ic{width:22px;height:22px;flex:none}\n\n  .top{position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 16px 0}\n  .level{height:36px;padding:0 17px;display:flex;align-items:center;gap:7px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px);font-size:12.5px;letter-spacing:.03em;color:var(--muted);text-transform:uppercase}\n  .level b{font-family:var(--display);font-size:15px;font-weight:700;color:var(--cream);letter-spacing:0;text-transform:none}\n  .coins{height:36px;padding:0 5px;display:flex;align-items:center;gap:9px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px)}\n  .coin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 2px 6px rgba(0,0,0,.45);color:#6b4500}\n  .coin .ic{width:13px;height:13px}\n  .amt{font-size:13.5px;font-weight:700;color:var(--cream)}\n  .plus{width:26px;height:26px;border:1px solid rgba(159,243,232,.32);border-radius:50%;background:rgba(128,213,203,.16);color:var(--teal-lift);font-size:15px;line-height:1;display:grid;place-items:center;cursor:pointer;transition:background .18s ease,transform .18s ease}\n  .plus:active{transform:scale(.92)}\n\n  .board{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:0 16px}\n  .grid{display:grid;grid-template-columns:repeat(6,54px);gap:6px;justify-items:center}\n  .void{width:54px;height:54px}\n  .tile{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;font-family:var(--display);font-size:27px;font-weight:700;color:#0d4a46;background:linear-gradient(180deg,#fffdf4,#f7ebd1);box-shadow:0 4px 0 var(--bevel),0 10px 16px rgba(0,0,0,.33),inset 0 1px 0 #fff}\n  .slot{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;background:rgba(238,255,252,.055);border:1px solid rgba(255,255,255,.13)}\n  .slot i{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.24)}\n  .slot.g {border-color:rgba(245,184,61,.34);background:rgba(245,184,61,.08)}\n\n  /* merged record capsule */\n  .record{height:38px;display:flex;align-items:center;gap:0;padding:0 5px 0 12px;border-radius:19px;background:rgba(8,26,30,.68);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(14px)}\n  .rec{display:flex;align-items:center;gap:7px;background:none;border:0;padding:0 8px;height:30px;border-radius:15px;color:var(--text);font-family:var(--ui);font-size:11.5px;font-weight:600;cursor:pointer;transition:background .2s ease}\n  .rec:hover{background:rgba(255,255,255,.06)}\n  .rec .ic{width:14px;height:14px;color:var(--teal-lift)}\n  .frac{font-size:10.5px;font-weight:700;color:#3d2800;background:linear-gradient(180deg,#ffcf72,#f5b83d);padding:2px 6px;border-radius:8px;letter-spacing:.04em}\n  .divider{width:1px;height:18px;background:rgba(255,255,255,.14);margin:0 2px}\n  .accepted{display:flex;align-items:center;gap:6px;padding:0 10px 0 8px}\n  .rec .word{font-family:var(--display);font-size:14px;font-weight:700;color:var(--cream);letter-spacing:.05em}\n  .rec .tick{width:14px;height:14px;border-radius:50%;display:grid;place-items:center;background:rgba(159,243,232,.18);color:var(--teal-lift)}\n  .rec .tick .ic{width:9px;height:9px}\n\n  .play{position:relative;display:flex;align-items:center;justify-content:space-between;padding:0 10px 6px}\n  .side{display:flex;flex-direction:column;align-items:center;gap:5px;background:none;border:0;padding:0;cursor:pointer;font-family:var(--ui)}\n  .side .disc{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px);color:var(--cream);box-shadow:0 6px 18px rgba(0,0,0,.4);transition:transform .16s ease,border-color .2s ease,background .2s ease}\n  .side .disc .ic{width:21px;height:21px}\n  .side:hover .disc{border-color:rgba(159,243,232,.42);background:rgba(20,50,54,.74)}\n  .side:active .disc{transform:translateY(1px) scale(.95)}\n  .side .lbl{font-size:9.5px;font-weight:600;color:var(--muted);line-height:1.1;text-align:center;letter-spacing:.01em}\n  .side.bonus .disc{color:#ffd790;border-color:rgba(245,184,61,.34)}\n\n  .wheel{position:relative;width:232px;height:232px}\n  .ring{position:absolute;inset:-3px;width:238px;height:238px;transform:rotate(-90deg);pointer-events:none}\n  .platter{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 32%,rgba(40,110,104,.4),rgba(7,30,34,.16) 66%,rgba(6,26,30,0) 100%);border:1px solid rgba(255,255,255,.08)}\n  .node{position:absolute;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:21px;font-weight:700;color:#0d3f3b;background:linear-gradient(180deg,#fffdf4,#f2e2c4);box-shadow:0 4px 0 var(--bevel),0 8px 14px rgba(0,0,0,.35),inset 0 1px 0 #fff;cursor:pointer;transition:transform .15s ease,box-shadow .2s ease}\n  .node:hover{transform:translateY(-1px)}\n  .node.found{box-shadow:0 0 0 2px rgba(245,184,61,.6),0 0 18px rgba(245,184,61,.26),0 4px 0 var(--bevel),inset 0 1px 0 #fff}\n  .shuffle{position:absolute;left:88px;top:88px;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;color:#d7ecea;background:rgba(9,30,34,.66);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(14px);cursor:pointer;transition:transform .35s ease,background .2s ease}\n  .shuffle .ic{width:21px;height:21px}\n  .shuffle:active{transform:rotate(180deg)}\n\n  .tabs{position:relative;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 8px 13px;border-top:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,rgba(5,20,25,.55),rgba(3,13,18,.94));backdrop-filter:blur(18px)}\n  .tab{display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px 0;background:none;border:0;color:var(--muted);font-family:var(--ui);font-size:10.5px;font-weight:600;cursor:pointer;transition:color .18s ease}\n  .tab .ic{width:21px;height:21px}\n  .tab:hover{color:#cfe6e4}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol fill=\"none\" id=\"i-home\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M5 12l-2 0l9 -9l9 9l-2 0\"></path><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7\"></path><path d=\"M10 12h4v4h-4z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-book\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12z\"></path><path d=\"M19 16h-12a2 2 0 0 0 -2 2\"></path><path d=\"M9 8h6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-medal\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M9 3h6l3 7l-6 2l-6 -2z\"></path><path d=\"M12 12l-3 -9\"></path><path d=\"M15 11l-3 -8\"></path><path d=\"M12 19.5l-3 1.5l.5 -3.5l-2 -2l3 -.5l1.5 -3l1.5 3l3 .5l-2 2l.5 3.5z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-settings\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z\"></path><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path></symbol>\n<symbol id=\"i-star\" viewbox=\"0 0 24 24\"><path d=\"M12 3l2.47 6.1l6.56 .46l-5.04 4.24l1.59 6.39L12 16.7L6.42 20.19l1.59 -6.39L2.97 9.56l6.56 -.46z\" fill=\"currentColor\"></path></symbol>\n<symbol fill=\"none\" id=\"i-list\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M9 6l11 0\"></path><path d=\"M9 12l11 0\"></path><path d=\"M9 18l11 0\"></path><path d=\"M5 6l0 .01\"></path><path d=\"M5 12l0 .01\"></path><path d=\"M5 18l0 .01\"></path></symbol>\n<symbol fill=\"none\" id=\"i-check\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.4\" viewbox=\"0 0 24 24\"><path d=\"M5 12l5 5l10 -10\"></path></symbol>\n<symbol fill=\"none\" id=\"i-tool\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M4 7h16\"></path><path d=\"M4 17h16\"></path><circle cx=\"9\" cy=\"7\" r=\"2.4\"></circle><circle cx=\"15\" cy=\"17\" r=\"2.4\"></circle></symbol>\n<symbol fill=\"none\" id=\"i-shuffle\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M18 4l3 3l-3 3\"></path><path d=\"M18 20l3 -3l-3 -3\"></path><path d=\"M3 7h3a5 5 0 0 1 5 5a5 5 0 0 0 5 5h5\"></path><path d=\"M21 7h-5a4.978 4.978 0 0 0 -3 1m-4 8a4.984 4.984 0 0 1 -3 1h-3\"></path></symbol>\n</svg>\n<div class=\"screen\" data-kid=\"2\">\n<svg aria-hidden=\"true\" class=\"scene\" data-kid=\"2-1\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 390 844\">\n<defs>\n<lineargradient id=\"dusk\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#04121c\"></stop>\n<stop offset=\".28\" stop-color=\"#0a2436\"></stop>\n<stop offset=\".44\" stop-color=\"#153b4c\"></stop>\n<stop offset=\".52\" stop-color=\"#2c5560\"></stop>\n<stop offset=\".6\" stop-color=\"#0d2733\"></stop>\n<stop offset=\"1\" stop-color=\"#03101a\"></stop>\n</lineargradient>\n<radialgradient cx=\"50%\" cy=\"50%\" id=\"sun\" r=\"50%\">\n<stop offset=\"0\" stop-color=\"#ffd9a0\" stop-opacity=\".55\"></stop>\n<stop offset=\".5\" stop-color=\"#ffb066\" stop-opacity=\".16\"></stop>\n<stop offset=\"1\" stop-color=\"#ff9a4d\" stop-opacity=\"0\"></stop>\n</radialgradient>\n<lineargradient id=\"sea\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#12303c\"></stop><stop offset=\".45\" stop-color=\"#08202c\"></stop><stop offset=\"1\" stop-color=\"#020e17\"></stop>\n</lineargradient>\n<lineargradient id=\"path\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#ffcf94\" stop-opacity=\".34\"></stop>\n<stop offset=\"1\" stop-color=\"#ffcf94\" stop-opacity=\"0\"></stop>\n</lineargradient>\n<filter height=\"220%\" id=\"soft\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"14\"></fegaussianblur></filter>\n<filter height=\"220%\" id=\"haze\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"30\"></fegaussianblur></filter>\n<symbol id=\"pine\" viewbox=\"0 0 16 40\"><path d=\"M8 0l5 11H3zM8 7l6 13H2zM8 15l7 15H1zM7 30h2v10H7z\"></path></symbol>\n</defs>\n<rect fill=\"url(#dusk)\" height=\"844\" width=\"390\"></rect>\n<circle cx=\"238\" cy=\"404\" fill=\"url(#sun)\" r=\"150\"></circle>\n<circle cx=\"238\" cy=\"404\" fill=\"#ffe2b6\" filter=\"url(#soft)\" opacity=\".5\" r=\"34\"></circle>\n<path d=\"M0 336 L38 314 L82 338 L120 306 L164 336 L206 310 L250 340 L292 314 L336 340 L390 316 L390 470 L0 470 Z\" fill=\"#1d4a56\" opacity=\".55\"></path>\n<path d=\"M0 388 L34 366 L76 390 L118 360 L160 390 L202 366 L244 392 L288 368 L330 394 L390 370 L390 480 L0 480 Z\" fill=\"#0a2330\"></path>\n<rect fill=\"url(#sea)\" height=\"414\" width=\"390\" y=\"430\"></rect>\n<rect fill=\"url(#path)\" filter=\"url(#soft)\" height=\"320\" opacity=\".55\" width=\"56\" x=\"212\" y=\"430\"></rect>\n<ellipse cx=\"238\" cy=\"452\" fill=\"#ffcf94\" filter=\"url(#soft)\" opacity=\".24\" rx=\"40\" ry=\"5\"></ellipse>\n<ellipse cx=\"238\" cy=\"492\" fill=\"#ffcf94\" filter=\"url(#soft)\" opacity=\".18\" rx=\"26\" ry=\"4\"></ellipse>\n<ellipse cx=\"120\" cy=\"560\" fill=\"#9fd8e6\" filter=\"url(#soft)\" opacity=\".05\" rx=\"190\" ry=\"16\"></ellipse>\n<g fill=\"#03121a\" opacity=\".92\">\n<use height=\"55\" href=\"#pine\" width=\"22\" x=\"-8\" y=\"392\"></use>\n<use height=\"40\" href=\"#pine\" width=\"16\" x=\"10\" y=\"404\"></use>\n<use height=\"60\" href=\"#pine\" width=\"24\" x=\"366\" y=\"386\"></use>\n<use height=\"40\" href=\"#pine\" width=\"16\" x=\"350\" y=\"404\"></use>\n</g>\n</svg>\n<div class=\"scrim\" data-kid=\"2-2\"></div>\n<header class=\"top\" data-kid=\"2-3\">\n<div class=\"level\" data-kid=\"2-3-1\">Level <b data-kid=\"2-3-1-1\">14</b></div>\n<div class=\"coins\" data-kid=\"2-3-2\">\n<span class=\"coin\" data-kid=\"2-3-2-1\"><svg class=\"ic\" data-kid=\"2-3-2-1-1\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"amt\" data-kid=\"2-3-2-2\">1,450</span>\n<button aria-label=\"Get more coins\" class=\"plus\" data-kid=\"2-3-2-3\">+</button>\n</div>\n</header>\n<main class=\"board\" data-kid=\"2-4\">\n<div aria-label=\"Crossword board for level 14, five of fourteen letters placed\" class=\"grid\" data-kid=\"2-4-1\" role=\"grid\">\n<div class=\"tile\" data-kid=\"2-4-1-1\">T</div>\n<div class=\"tile\" data-kid=\"2-4-1-2\">I</div>\n<div class=\"tile\" data-kid=\"2-4-1-3\">M</div>\n<div class=\"tile\" data-kid=\"2-4-1-4\">B</div>\n<div class=\"tile\" data-kid=\"2-4-1-5\">E</div>\n<div class=\"tile\" data-kid=\"2-4-1-6\">R</div>\n<div class=\"tile\" data-kid=\"2-4-1-7\">R</div>\n<div class=\"void\" data-kid=\"2-4-1-8\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-9\"><i data-kid=\"2-4-1-9-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-10\"></div>\n<div class=\"slot g\" data-kid=\"2-4-1-11\"><i data-kid=\"2-4-1-11-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-12\"></div>\n<div class=\"tile\" data-kid=\"2-4-1-13\">I</div>\n<div class=\"void\" data-kid=\"2-4-1-14\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-15\"><i data-kid=\"2-4-1-15-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-16\"></div>\n<div class=\"slot g\" data-kid=\"2-4-1-17\"><i data-kid=\"2-4-1-17-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-18\"></div>\n<div class=\"tile\" data-kid=\"2-4-1-19\">B</div>\n<div class=\"void\" data-kid=\"2-4-1-20\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-21\"><i data-kid=\"2-4-1-21-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-22\"></div>\n<div class=\"slot g\" data-kid=\"2-4-1-23\"><i data-kid=\"2-4-1-23-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-24\"></div>\n<div class=\"tile\" data-kid=\"2-4-1-25\">E</div>\n<div class=\"void\" data-kid=\"2-4-1-26\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-27\"><i data-kid=\"2-4-1-27-1\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-28\"></div>\n<div class=\"void\" data-kid=\"2-4-1-29\"></div>\n<div class=\"void\" data-kid=\"2-4-1-30\"></div>\n</div>\n<div class=\"record\" data-kid=\"2-4-2\">\n<button class=\"rec\" data-kid=\"2-4-2-1\">\n<svg class=\"ic\" data-kid=\"2-4-2-1-1\"><use href=\"#i-list\"></use></svg>\n<span data-kid=\"2-4-2-1-2\">Bonus words</span>\n<span class=\"frac\" data-kid=\"2-4-2-1-3\">4 / 5</span>\n</button>\n<span class=\"divider\" data-kid=\"2-4-2-2\"></span>\n<div class=\"accepted\" data-kid=\"2-4-2-3\">\n<span class=\"word\" data-kid=\"2-4-2-3-1\">BRIM</span>\n<span class=\"tick\" data-kid=\"2-4-2-3-2\"><svg class=\"ic\" data-kid=\"2-4-2-3-2-1\"><use href=\"#i-check\"></use></svg></span>\n</div>\n</div>\n</main>\n<section class=\"play\" data-kid=\"2-5\">\n<button aria-label=\"Bonus words, 4 of 5 found\" class=\"side bonus\" data-kid=\"2-5-1\">\n<span class=\"disc\" data-kid=\"2-5-1-1\"><svg class=\"ic\" data-kid=\"2-5-1-1-1\"><use href=\"#i-list\"></use></svg></span>\n<span class=\"lbl\" data-kid=\"2-5-1-2\">Bonus<br data-kid=\"2-5-1-2-1\"/>words</span>\n</button>\n<div class=\"wheel\" data-kid=\"2-5-2\">\n<svg aria-hidden=\"true\" class=\"ring\" data-kid=\"2-5-2-1\" viewbox=\"0 0 238 238\">\n<circle cx=\"119\" cy=\"119\" fill=\"none\" r=\"116\" stroke=\"rgba(255,255,255,.08)\" stroke-width=\"3\"></circle>\n<circle cx=\"119\" cy=\"119\" fill=\"none\" opacity=\".8\" r=\"116\" stroke=\"#f5b83d\" stroke-dasharray=\"583 729\" stroke-linecap=\"round\" stroke-width=\"3\"></circle>\n</svg>\n<div class=\"platter\" data-kid=\"2-5-2-2\"></div>\n<button aria-label=\"Letter T\" class=\"node\" data-kid=\"2-5-2-3\" style=\"left:92px;top:6px\">T</button>\n<button aria-label=\"Letter I\" class=\"node\" data-kid=\"2-5-2-4\" style=\"left:166.5px;top:49px\">I</button>\n<button aria-label=\"Letter M, used in bonus word BRIM\" class=\"node found\" data-kid=\"2-5-2-5\" style=\"left:166.5px;top:135px\">M</button>\n<button aria-label=\"Letter B, used in bonus word BRIM\" class=\"node found\" data-kid=\"2-5-2-6\" style=\"left:92px;top:178px\">B</button>\n<button aria-label=\"Letter E\" class=\"node\" data-kid=\"2-5-2-7\" style=\"left:17.5px;top:135px\">E</button>\n<button aria-label=\"Letter R, used in bonus word BRIM\" class=\"node found\" data-kid=\"2-5-2-8\" style=\"left:17.5px;top:49px\">R</button>\n<button aria-label=\"Shuffle letters\" class=\"shuffle\" data-kid=\"2-5-2-9\"><svg class=\"ic\" data-kid=\"2-5-2-9-1\"><use href=\"#i-shuffle\"></use></svg></button>\n</div>\n<button aria-label=\"Tools: hint and target\" class=\"side\" data-kid=\"2-5-3\">\n<span class=\"disc\" data-kid=\"2-5-3-1\"><svg class=\"ic\" data-kid=\"2-5-3-1-1\"><use href=\"#i-tool\"></use></svg></span>\n<span class=\"lbl\" data-kid=\"2-5-3-2\">Tools</span>\n</button>\n</section>\n<nav aria-label=\"Main\" class=\"tabs\" data-kid=\"2-6\">\n<button class=\"tab\" data-kid=\"2-6-1\"><svg class=\"ic\" data-kid=\"2-6-1-1\"><use href=\"#i-home\"></use></svg>Home</button>\n<button class=\"tab\" data-kid=\"2-6-2\"><svg class=\"ic\" data-kid=\"2-6-2-1\"><use href=\"#i-book\"></use></svg>Chapters</button>\n<button class=\"tab\" data-kid=\"2-6-3\"><svg class=\"ic\" data-kid=\"2-6-3-1\"><use href=\"#i-medal\"></use></svg>Missions</button>\n<button class=\"tab\" data-kid=\"2-6-4\"><svg class=\"ic\" data-kid=\"2-6-4-1\"><use href=\"#i-settings\"></use></svg>Settings</button>\n</nav>\n</div>\n",
