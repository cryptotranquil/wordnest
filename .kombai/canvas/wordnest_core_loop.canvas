    "var_859598b72946": {
      "type": "variant",
      "label": "Gameplay A — Continuous solve, full-bleed scenery",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n\n  :root{\n    --cream:#fff8e7;\n    --bevel:#d7c199;\n    --teal:#0f766e;\n    --teal-lift:#9ff3e8;\n    --gold:#f5b83d;\n    --text:#e7f2f3;\n    --muted:#94aaa8;\n    --glass:rgba(13,32,36,.56);\n    --glass-line:rgba(255,255,255,.15);\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif;\n    --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);color:var(--text);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px;display:block}\n  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,17,22,.86) 0%,rgba(5,22,27,.34) 16%,rgba(5,22,26,.42) 52%,rgba(4,15,20,.86) 88%,rgba(3,12,17,.96) 100%)}\n  .ic{width:22px;height:22px;flex:none}\n\n  /* ---------- chrome ---------- */\n  .top{position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 16px 0}\n  .level{height:36px;padding:0 17px;display:flex;align-items:center;gap:7px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px);font-size:12.5px;letter-spacing:.03em;color:var(--muted);text-transform:uppercase}\n  .level b{font-family:var(--display);font-size:15px;font-weight:700;color:var(--cream);letter-spacing:0;text-transform:none}\n  .coins{height:36px;padding:0 5px 0 5px;display:flex;align-items:center;gap:9px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px)}\n  .coin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 2px 6px rgba(0,0,0,.45);color:#6b4500}\n  .coin .ic{width:13px;height:13px}\n  .amt{font-size:13.5px;font-weight:700;color:var(--cream);letter-spacing:.02em}\n  .plus{width:26px;height:26px;border:1px solid rgba(159,243,232,.32);border-radius:50%;background:rgba(128,213,203,.16);color:var(--teal-lift);font-size:15px;line-height:1;display:grid;place-items:center;cursor:pointer;font-family:var(--ui);transition:background .18s ease,transform .18s ease}\n  .plus:hover{background:rgba(128,213,203,.3)}\n  .plus:active{transform:scale(.92)}\n\n  /* ---------- board ---------- */\n  .board{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;padding:0 16px}\n  .grid{display:grid;grid-template-columns:repeat(6,54px);gap:6px;justify-items:center}\n  .void{width:54px;height:54px}\n  .tile{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;font-family:var(--display);font-size:27px;font-weight:700;color:#0d4a46;background:linear-gradient(180deg,#fffdf4,#f7ebd1);box-shadow:0 4px 0 var(--bevel),0 10px 16px rgba(0,0,0,.34),inset 0 1px 0 #fff}\n  .slot{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;background:rgba(238,255,252,.055);border:1px solid rgba(255,255,255,.13);box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}\n  .slot i{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.24)}\n  .fresh{position:relative}\n  .fresh::after{content:'';position:absolute;top:-2px;right:-2px;width:9px;height:9px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px rgba(245,184,61,.9)}\n\n  .bonus{height:30px;display:flex;align-items:center;gap:8px;padding:0 11px;border-radius:15px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(14px);color:var(--text);font-family:var(--ui);font-size:12px;font-weight:600;cursor:pointer;transition:border-color .2s ease,background .2s ease}\n  .bonus .ic{width:15px;height:15px;color:var(--teal-lift)}\n  .bonus:hover{border-color:rgba(159,243,232,.4);background:rgba(19,44,48,.7)}\n  .frac{font-size:11px;font-weight:700;color:#422d00;background:var(--gold);padding:2px 7px;border-radius:9px;letter-spacing:.04em}\n\n  .string{height:36px;min-width:134px;display:flex;align-items:center;justify-content:center;gap:12px;padding:0 18px;border-radius:18px;background:rgba(7,25,29,.66);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(14px)}\n  .string span{font-family:var(--display);font-size:17px;font-weight:700;color:var(--cream)}\n  .string em{width:5px;height:5px;border-radius:50%;background:var(--teal-lift);box-shadow:0 0 9px rgba(159,243,232,.95)}\n\n  /* ---------- play zone ---------- */\n  .pool{position:absolute;left:50%;top:0;transform:translateX(-50%);width:390px;height:300px;background:radial-gradient(ellipse at 50% 55%,rgba(32,140,128,.34),rgba(9,40,44,.12) 55%,rgba(6,22,26,0) 78%);pointer-events:none}\n  .play{position:relative;display:flex;align-items:center;justify-content:space-between;padding:2px 12px 6px}\n  .booster{display:flex;flex-direction:column;align-items:center;gap:6px;background:none;border:0;padding:0;cursor:pointer;font-family:var(--ui)}\n  .booster .disc{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px);color:var(--cream);box-shadow:0 6px 18px rgba(0,0,0,.4);transition:transform .16s ease,border-color .2s ease,background .2s ease}\n  .booster:hover .disc{border-color:rgba(159,243,232,.45);background:rgba(20,50,54,.74)}\n  .booster:active .disc{transform:translateY(1px) scale(.95)}\n  .cost{display:flex;align-items:center;gap:4px;font-size:10.5px;font-weight:700;color:#ffd790;letter-spacing:.02em}\n\n  .wheel{position:relative;width:232px;height:232px}\n  .platter{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 32%,rgba(40,110,104,.42),rgba(7,30,34,.18) 66%,rgba(6,26,30,0) 100%);border:1px solid rgba(255,255,255,.08)}\n  .ribbon{position:absolute;inset:0;filter:drop-shadow(0 0 12px rgba(80,222,205,.55))}\n  .node{position:absolute;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:21px;font-weight:700;color:#0d3f3b;background:linear-gradient(180deg,#fffdf4,#f2e2c4);box-shadow:0 4px 0 var(--bevel),0 8px 14px rgba(0,0,0,.36),inset 0 1px 0 #fff;cursor:pointer;transition:transform .15s ease,box-shadow .2s ease,background .2s ease,color .2s ease}\n  .node:hover{transform:translateY(-1px)}\n  .node.on{color:#eafffb;background:linear-gradient(180deg,#12968b,#0b5f59);box-shadow:0 0 0 2px rgba(159,243,232,.5),0 0 26px rgba(70,214,198,.5),0 4px 0 #084d48}\n  .shuffle{position:absolute;left:88px;top:88px;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;color:#d7ecea;background:rgba(9,30,34,.66);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(14px);cursor:pointer;transition:transform .35s ease,background .2s ease}\n  .shuffle .ic{width:21px;height:21px}\n  .shuffle:hover{background:rgba(23,58,62,.8)}\n  .shuffle:active{transform:rotate(180deg)}\n\n  /* ---------- tabs ---------- */\n  .tabs{position:relative;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 8px 13px;border-top:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,rgba(5,20,25,.55),rgba(3,13,18,.94));backdrop-filter:blur(18px)}\n  .tab{display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px 0;background:none;border:0;color:var(--muted);font-family:var(--ui);font-size:10.5px;font-weight:600;letter-spacing:.01em;cursor:pointer;transition:color .18s ease}\n  .tab .ic{width:21px;height:21px}\n  .tab:hover{color:#cfe6e4}\n  .tab[aria-current=\"page\"]{color:var(--teal-lift)}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden icon sprite sheet\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol fill=\"none\" id=\"i-home\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M5 12l-2 0l9 -9l9 9l-2 0\"></path><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7\"></path><path d=\"M10 12h4v4h-4z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-book\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12z\"></path><path d=\"M19 16h-12a2 2 0 0 0 -2 2\"></path><path d=\"M9 8h6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-medal\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M9 3h6l3 7l-6 2l-6 -2z\"></path><path d=\"M12 12l-3 -9\"></path><path d=\"M15 11l-3 -8\"></path><path d=\"M12 19.5l-3 1.5l.5 -3.5l-2 -2l3 -.5l1.5 -3l1.5 3l3 .5l-2 2l.5 3.5z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-settings\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z\"></path><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path></symbol>\n<symbol id=\"i-star\" viewbox=\"0 0 24 24\"><path d=\"M12 3l2.47 6.1l6.56 .46l-5.04 4.24l1.59 6.39L12 16.7L6.42 20.19l1.59 -6.39L2.97 9.56l6.56 -.46z\" fill=\"currentColor\"></path></symbol>\n<symbol fill=\"none\" id=\"i-notebook\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18\"></path><path d=\"M13 8l2 0\"></path><path d=\"M13 12l2 0\"></path></symbol>\n<symbol fill=\"none\" id=\"i-bulb\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7\"></path><path d=\"M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3\"></path><path d=\"M9.7 17l4.6 0\"></path></symbol>\n<symbol fill=\"none\" id=\"i-focus\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" fill=\"currentColor\" r=\".6\"></circle><path d=\"M12 12m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0\"></path><path d=\"M12 3l0 2\"></path><path d=\"M3 12l2 0\"></path><path d=\"M12 19l0 2\"></path><path d=\"M19 12l2 0\"></path></symbol>\n<symbol fill=\"none\" id=\"i-shuffle\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M18 4l3 3l-3 3\"></path><path d=\"M18 20l3 -3l-3 -3\"></path><path d=\"M3 7h3a5 5 0 0 1 5 5a5 5 0 0 0 5 5h5\"></path><path d=\"M21 7h-5a4.978 4.978 0 0 0 -3 1m-4 8a4.984 4.984 0 0 1 -3 1h-3\"></path></symbol>\n<symbol id=\"i-play\" viewbox=\"0 0 24 24\"><path d=\"M8 5.2l11 6.8l-11 6.8z\" fill=\"currentColor\"></path></symbol>\n<symbol fill=\"none\" id=\"i-arrow-right\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M5 12l14 0\"></path><path d=\"M13 18l6 -6\"></path><path d=\"M13 6l6 6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-chevron\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M9 6l6 6l-6 6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-gift\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M3 8m0 1a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z\"></path><path d=\"M12 8l0 13\"></path><path d=\"M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7\"></path><path d=\"M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5\"></path></symbol>\n<symbol fill=\"none\" id=\"i-check\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"M5 12l5 5l10 -10\"></path></symbol>\n<symbol fill=\"none\" id=\"i-x\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M18 6l-12 12\"></path><path d=\"M6 6l12 12\"></path></symbol>\n</svg>\n<div class=\"screen\" data-kid=\"2\" data-name=\"game screen container\">\n<svg aria-hidden=\"true\" class=\"scene\" data-kid=\"2-1\" data-name=\"inline SVG forest night scene\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 390 844\">\n<defs>\n<lineargradient id=\"sky\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#04141a\"></stop>\n<stop offset=\".34\" stop-color=\"#0a2b31\"></stop>\n<stop offset=\".52\" stop-color=\"#124044\"></stop>\n<stop offset=\".62\" stop-color=\"#0b2b31\"></stop>\n<stop offset=\".72\" stop-color=\"#061a20\"></stop>\n<stop offset=\"1\" stop-color=\"#03101a\"></stop>\n</lineargradient>\n<radialgradient cx=\"50%\" cy=\"50%\" id=\"moonGlow\" r=\"50%\">\n<stop offset=\"0\" stop-color=\"#ffeec2\" stop-opacity=\".5\"></stop>\n<stop offset=\".42\" stop-color=\"#a9e8db\" stop-opacity=\".16\"></stop>\n<stop offset=\"1\" stop-color=\"#0f766e\" stop-opacity=\"0\"></stop>\n</radialgradient>\n<lineargradient id=\"water\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#0a2b30\"></stop>\n<stop offset=\".4\" stop-color=\"#061e25\"></stop>\n<stop offset=\"1\" stop-color=\"#03121a\"></stop>\n</lineargradient>\n<lineargradient id=\"reflect\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#ffe7b5\" stop-opacity=\".3\"></stop>\n<stop offset=\"1\" stop-color=\"#ffe7b5\" stop-opacity=\"0\"></stop>\n</lineargradient>\n<filter height=\"220%\" id=\"soft\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"14\"></fegaussianblur></filter>\n<filter height=\"220%\" id=\"haze\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"26\"></fegaussianblur></filter>\n<symbol id=\"pine\" viewbox=\"0 0 16 40\"><path d=\"M8 0l5 11H3zM8 7l6 13H2zM8 15l7 15H1zM7 30h2v10H7z\"></path></symbol>\n</defs>\n<rect fill=\"url(#sky)\" height=\"844\" width=\"390\"></rect>\n<ellipse cx=\"150\" cy=\"250\" fill=\"#2ea79b\" filter=\"url(#haze)\" opacity=\".1\" rx=\"230\" ry=\"120\"></ellipse>\n<ellipse cx=\"195\" cy=\"432\" fill=\"url(#moonGlow)\" opacity=\".8\" rx=\"250\" ry=\"94\"></ellipse>\n<path d=\"M0 322 L44 292 L86 318 L128 284 L176 316 L214 290 L262 320 L306 296 L350 322 L390 302 L390 470 L0 470 Z\" fill=\"#0e343b\" opacity=\".9\"></path>\n<path d=\"M0 366 L38 342 L82 364 L124 336 L168 366 L206 344 L252 370 L296 348 L342 372 L390 350 L390 480 L0 480 Z\" fill=\"#0a282f\"></path>\n<ellipse cx=\"196\" cy=\"430\" fill=\"#c9f2ea\" filter=\"url(#soft)\" opacity=\".07\" rx=\"230\" ry=\"26\"></ellipse>\n<rect fill=\"url(#water)\" height=\"392\" width=\"390\" y=\"452\"></rect>\n<path d=\"M0 452 L390 452 L390 470 L0 470 Z\" fill=\"#051a20\" opacity=\".9\"></path>\n<g fill=\"#04161c\">\n<use height=\"85\" href=\"#pine\" width=\"34\" x=\"-4\" y=\"367\"></use>\n<use height=\"70\" href=\"#pine\" width=\"28\" x=\"24\" y=\"382\"></use>\n<use height=\"60\" href=\"#pine\" width=\"24\" x=\"47\" y=\"392\"></use>\n<use height=\"45\" href=\"#pine\" width=\"18\" x=\"66\" y=\"407\"></use>\n<use height=\"55\" href=\"#pine\" width=\"22\" x=\"310\" y=\"397\"></use>\n<use height=\"70\" href=\"#pine\" width=\"28\" x=\"330\" y=\"382\"></use>\n<use height=\"60\" href=\"#pine\" width=\"24\" x=\"354\" y=\"392\"></use>\n<use height=\"50\" href=\"#pine\" width=\"20\" x=\"373\" y=\"402\"></use>\n</g>\n<rect fill=\"url(#reflect)\" filter=\"url(#soft)\" height=\"300\" width=\"54\" x=\"272\" y=\"452\"></rect>\n<ellipse cx=\"298\" cy=\"500\" fill=\"#ffeec2\" filter=\"url(#soft)\" opacity=\".16\" rx=\"52\" ry=\"7\"></ellipse>\n<ellipse cx=\"298\" cy=\"556\" fill=\"#ffeec2\" filter=\"url(#soft)\" opacity=\".1\" rx=\"34\" ry=\"5\"></ellipse>\n<ellipse cx=\"298\" cy=\"624\" fill=\"#c9f2ea\" filter=\"url(#soft)\" opacity=\".07\" rx=\"24\" ry=\"4\"></ellipse>\n<ellipse cx=\"120\" cy=\"486\" fill=\"#c9f2ea\" filter=\"url(#soft)\" opacity=\".06\" rx=\"200\" ry=\"18\"></ellipse>\n<ellipse cx=\"250\" cy=\"700\" fill=\"#8fd8c9\" filter=\"url(#soft)\" opacity=\".05\" rx=\"260\" ry=\"22\"></ellipse>\n</svg>\n<div class=\"scrim\" data-kid=\"2-2\" data-name=\"darkening scrim overlay\"></div>\n<header class=\"top\" data-kid=\"2-3\" data-name=\"top status bar\">\n<div class=\"level\" data-kid=\"2-3-1\" data-name=\"current level pill\">Level <b data-kid=\"2-3-1-1\" data-name=\"level number\">14</b></div>\n<div class=\"coins\" data-kid=\"2-3-2\" data-name=\"coin balance container\">\n<span class=\"coin\" data-kid=\"2-3-2-1\" data-name=\"gold coin badge\"><svg class=\"ic\" data-kid=\"2-3-2-1-1\" data-name=\"star icon\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"amt\" data-kid=\"2-3-2-2\" data-name=\"coin amount count\">1,450</span>\n<button aria-label=\"Get more coins\" class=\"plus\" data-kid=\"2-3-2-3\" data-name=\"add coins button\">+</button>\n</div>\n</header>\n<main class=\"board\" data-kid=\"2-4\" data-name=\"main crossword board\">\n<div aria-label=\"Crossword board for level 14, five of fourteen letters placed\" class=\"grid\" data-kid=\"2-4-1\" data-name=\"crossword grid\" role=\"grid\">\n<div class=\"tile\" data-kid=\"2-4-1-1\" data-name=\"filled letter tile T\">T</div>\n<div class=\"tile\" data-kid=\"2-4-1-2\" data-name=\"filled letter tile I\">I</div>\n<div class=\"tile\" data-kid=\"2-4-1-3\" data-name=\"filled letter tile M\">M</div>\n<div class=\"tile\" data-kid=\"2-4-1-4\" data-name=\"filled letter tile B\">B</div>\n<div class=\"tile\" data-kid=\"2-4-1-5\" data-name=\"filled letter tile E\">E</div>\n<div class=\"tile fresh\" data-kid=\"2-4-1-6\" data-name=\"freshly placed letter tile R\">R</div>\n<div class=\"tile\" data-kid=\"2-4-1-7\" data-name=\"filled letter tile R\">R</div>\n<div class=\"void\" data-kid=\"2-4-1-8\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-9\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-9-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-10\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-11\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-11-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-12\" data-name=\"blocked grid cell\"></div>\n<div class=\"tile\" data-kid=\"2-4-1-13\" data-name=\"filled letter tile I\">I</div>\n<div class=\"void\" data-kid=\"2-4-1-14\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-15\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-15-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-16\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-17\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-17-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-18\" data-name=\"blocked grid cell\"></div>\n<div class=\"tile\" data-kid=\"2-4-1-19\" data-name=\"filled letter tile B\">B</div>\n<div class=\"void\" data-kid=\"2-4-1-20\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-21\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-21-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-22\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-23\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-23-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-24\" data-name=\"blocked grid cell\"></div>\n<div class=\"tile\" data-kid=\"2-4-1-25\" data-name=\"filled letter tile E\">E</div>\n<div class=\"void\" data-kid=\"2-4-1-26\" data-name=\"blocked grid cell\"></div>\n<div class=\"slot\" data-kid=\"2-4-1-27\" data-name=\"empty open slot\"><i data-kid=\"2-4-1-27-1\" data-name=\"slot placeholder dot\"></i></div>\n<div class=\"void\" data-kid=\"2-4-1-28\" data-name=\"blocked grid cell\"></div>\n<div class=\"void\" data-kid=\"2-4-1-29\" data-name=\"blocked grid cell\"></div>\n<div class=\"void\" data-kid=\"2-4-1-30\" data-name=\"blocked grid cell\"></div>\n</div>\n<button class=\"bonus\" data-kid=\"2-4-2\" data-name=\"bonus words action button\">\n<svg class=\"ic\" data-kid=\"2-4-2-1\" data-name=\"notebook icon\"><use href=\"#i-notebook\"></use></svg>\n<span data-kid=\"2-4-2-2\" data-name=\"bonus words label\">Bonus words</span>\n<span class=\"frac\" data-kid=\"2-4-2-3\" data-name=\"bonus progress fraction\">4 / 5</span>\n</button>\n<div aria-label=\"Selected letters T I M B\" class=\"string\" data-kid=\"2-4-3\" data-name=\"selected-letters string display\">\n<span data-kid=\"2-4-3-1\" data-name=\"selected letter T\">T</span><span data-kid=\"2-4-3-2\" data-name=\"selected letter I\">I</span><span data-kid=\"2-4-3-3\" data-name=\"selected letter M\">M</span><span data-kid=\"2-4-3-4\" data-name=\"selected letter B\">B</span><em data-kid=\"2-4-3-5\" data-name=\"trailing cursor dot\"></em>\n</div>\n</main>\n<section class=\"play\" data-kid=\"2-5\" data-name=\"play controls area\">\n<div class=\"pool\" data-kid=\"2-5-1\" data-name=\"decorative teal glow pool\"></div>\n<button aria-label=\"Hint, costs 100 coins\" class=\"booster\" data-kid=\"2-5-2\" data-name=\"hint booster button\">\n<span class=\"disc\" data-kid=\"2-5-2-1\" data-name=\"hint icon disc\"><svg class=\"ic\" data-kid=\"2-5-2-1-1\" data-name=\"lightbulb hint icon\"><use href=\"#i-bulb\"></use></svg></span>\n<span class=\"cost\" data-kid=\"2-5-2-2\" data-name=\"booster coin cost label\"><span data-kid=\"2-5-2-2-1\" data-name=\"booster cost amount\">100</span></span>\n</button>\n<div class=\"wheel\" data-kid=\"2-5-3\" data-name=\"virtual letter wheel\">\n<div class=\"platter\" data-kid=\"2-5-3-1\" data-name=\"glass wheel platter\"></div>\n<svg aria-hidden=\"true\" class=\"ribbon\" data-kid=\"2-5-3-2\" data-name=\"connecting trail ribbon\" viewbox=\"0 0 232 232\">\n<defs>\n<lineargradient id=\"trail\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#bdfff6\"></stop>\n<stop offset=\"1\" stop-color=\"#0f766e\"></stop>\n</lineargradient>\n</defs>\n<polyline fill=\"none\" points=\"116,30 190.5,73 190.5,159 116,202\" stroke=\"url(#trail)\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"6\"></polyline>\n</svg>\n<button aria-label=\"Letter T, selected\" class=\"node on\" data-kid=\"2-5-3-3\" data-name=\"letter node T selected\" style=\"left:92px;top:6px\">T</button>\n<button aria-label=\"Letter I, selected\" class=\"node on\" data-kid=\"2-5-3-4\" data-name=\"letter node I selected\" style=\"left:166.5px;top:49px\">I</button>\n<button aria-label=\"Letter M, selected\" class=\"node on\" data-kid=\"2-5-3-5\" data-name=\"letter node M selected\" style=\"left:166.5px;top:135px\">M</button>\n<button aria-label=\"Letter B, selected\" class=\"node on\" data-kid=\"2-5-3-6\" data-name=\"letter node B selected\" style=\"left:92px;top:178px\">B</button>\n<button aria-label=\"Letter E\" class=\"node\" data-kid=\"2-5-3-7\" data-name=\"letter node E unselected\" style=\"left:17.5px;top:135px\">E</button>\n<button aria-label=\"Letter R\" class=\"node\" data-kid=\"2-5-3-8\" data-name=\"letter node R unselected\" style=\"left:17.5px;top:49px\">R</button>\n<button aria-label=\"Shuffle letters\" class=\"shuffle\" data-kid=\"2-5-3-9\" data-name=\"shuffle letters button\"><svg class=\"ic\" data-kid=\"2-5-3-9-1\" data-name=\"shuffle arrows icon\"><use href=\"#i-shuffle\"></use></svg></button>\n</div>\n<button aria-label=\"Target, costs 150 coins\" class=\"booster\" data-kid=\"2-5-4\" data-name=\"target booster button\">\n<span class=\"disc\" data-kid=\"2-5-4-1\" data-name=\"target icon disc\"><svg class=\"ic\" data-kid=\"2-5-4-1-1\" data-name=\"target focus icon\"><use href=\"#i-focus\"></use></svg></span>\n<span class=\"cost\" data-kid=\"2-5-4-2\" data-name=\"target coin cost label\"><span data-kid=\"2-5-4-2-1\" data-name=\"target cost amount\">150</span></span>\n</button>\n</section>\n<nav aria-label=\"Main\" class=\"tabs\" data-kid=\"2-6\" data-name=\"bottom main navigation tabs\">\n<button class=\"tab\" data-kid=\"2-6-1\" data-name=\"home tab button\"><svg class=\"ic\" data-kid=\"2-6-1-1\" data-name=\"home icon\"><use href=\"#i-home\"></use></svg>Home</button>\n<button class=\"tab\" data-kid=\"2-6-2\" data-name=\"chapters tab button\"><svg class=\"ic\" data-kid=\"2-6-2-1\" data-name=\"book icon\"><use href=\"#i-book\"></use></svg>Chapters</button>\n<button class=\"tab\" data-kid=\"2-6-3\" data-name=\"missions tab button\"><svg class=\"ic\" data-kid=\"2-6-3-1\" data-name=\"medal icon\"><use href=\"#i-medal\"></use></svg>Missions</button>\n<button class=\"tab\" data-kid=\"2-6-4\" data-name=\"settings tab button\"><svg class=\"ic\" data-kid=\"2-6-4-1\" data-name=\"settings gear icon\"><use href=\"#i-settings\"></use></svg>Settings</button>\n</nav>\n</div>\n",
      "comments": [],
      "created": "2026-11-06T12:20:05.442746+00:00",
      "modified": "2026-11-06T12:42:49.591631+00:00",
      "id": "var_859598b72946",
      "contentHeight": 844
    },
    "var_5251d6a0e4c4": {
      "type": "variant",
      "label": "Gameplay B — Selected entry, pattern capsule + console",
      "parentId": "var_859598b72946",
      "themeId": null,
      "rect": {
        "x": 490,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  :root{\n    --cream:#fff8e7; --bevel:#d7c199; --teal:#0f766e; --teal-lift:#9ff3e8; --gold:#f5b83d;\n    --text:#e8f2f3; --muted:#94aaa8; --glass:rgba(13,32,36,.56); --glass-line:rgba(255,255,255,.15);\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif; --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);color:var(--text);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px}\n  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,17,22,.8) 0%,rgba(6,24,29,.28) 18%,rgba(6,24,28,.42) 46%,rgba(4,15,20,.9) 92%)}\n  .ic{width:22px;height:22px;flex:none}\n\n  .top{position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 16px 0}\n  .level{height:36px;padding:0 17px;display:flex;align-items:center;gap:7px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px);font-size:12.5px;letter-spacing:.03em;color:var(--muted);text-transform:uppercase}\n  .level b{font-family:var(--display);font-size:15px;font-weight:700;color:var(--cream);letter-spacing:0;text-transform:none}\n  .coins{height:36px;padding:0 5px;display:flex;align-items:center;gap:9px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px)}\n  .coin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 2px 6px rgba(0,0,0,.45);color:#6b4500}\n  .coin .ic{width:13px;height:13px}\n  .amt{font-size:13.5px;font-weight:700;color:var(--cream)}\n  .plus{width:26px;height:26px;border:1px solid rgba(159,243,232,.32);border-radius:50%;background:rgba(128,213,203,.16);color:var(--teal-lift);font-size:15px;line-height:1;display:grid;place-items:center;cursor:pointer;transition:background .18s ease,transform .18s ease}\n  .plus:hover{background:rgba(128,213,203,.3)} .plus:active{transform:scale(.92)}\n\n  /* board field */\n  .board{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:0 16px 0}\n  .field{position:absolute;left:50%;top:50%;transform:translate(-50%,-54%);width:420px;height:430px;border-radius:50%;background:radial-gradient(ellipse at 50% 50%,rgba(35,110,104,.26),rgba(10,38,42,.1) 58%,rgba(6,22,26,0) 76%);pointer-events:none}\n  .grid{position:relative;display:grid;grid-template-columns:repeat(6,50px);gap:6px;justify-items:center}\n  .void{width:50px;height:50px}\n  .tile{width:50px;height:50px;border-radius:13px;display:grid;place-items:center;font-family:var(--display);font-size:25px;font-weight:700;color:#0d4a46;background:linear-gradient(180deg,#fffdf4,#f7ebd1);box-shadow:0 4px 0 var(--bevel),0 10px 16px rgba(0,0,0,.32),inset 0 1px 0 #fff;transition:box-shadow .2s ease,transform .16s ease}\n  .slot{width:50px;height:50px;border-radius:13px;display:grid;place-items:center;background:rgba(238,255,252,.055);border:1px solid rgba(255,255,255,.13)}\n  .slot i{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.24)}\n  .cell{cursor:pointer}\n  .cell:hover{transform:translateY(-1px)}\n  /* selected across entry = row of cells with tinted frames */\n  .tile.sel{box-shadow:0 0 0 2px rgba(159,243,232,.72),0 0 22px rgba(80,214,201,.28),0 4px 0 var(--bevel),inset 0 1px 0 #fff}\n  .slot.sel{background:rgba(159,243,232,.13);border-color:rgba(159,243,232,.66);box-shadow:inset 0 0 18px rgba(80,214,201,.18)}\n  .slot.sel i{width:14px;height:3px;border-radius:2px;background:rgba(226,255,251,.5)}\n\n  .selbar{height:28px;display:flex;align-items:center;gap:7px;padding:0 12px;border-radius:14px;background:rgba(9,30,34,.6);border:1px solid rgba(159,243,232,.28);color:#cfeeea;font-size:11.5px;font-weight:600;cursor:pointer;transition:background .2s ease,border-color .2s ease}\n  .selbar:hover{background:rgba(18,46,50,.74);border-color:rgba(159,243,232,.5)}\n  .selbar .ic{width:14px;height:14px;color:var(--teal-lift)}\n  .selbar .sep{width:1px;height:12px;background:rgba(255,255,255,.18)}\n  .selbar .len{color:var(--muted);font-weight:500}\n\n  .pattern{height:44px;display:flex;align-items:center;justify-content:center;gap:9px;padding:0 18px;border-radius:22px;background:rgba(7,25,29,.7);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(14px)}\n  .pattern b{font-family:var(--display);font-size:19px;font-weight:700;color:var(--cream);line-height:1}\n  .pattern s{width:16px;height:16px;border-radius:4px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);text-decoration:none}\n  .pattern em{width:1px;height:16px;background:rgba(255,255,255,.12);margin:0 2px}\n  .pattern .hint{font-size:10.5px;font-weight:700;color:#ffd790;letter-spacing:.04em;text-transform:uppercase}\n\n  /* console */\n  .console{position:relative;display:flex;flex-direction:column;align-items:center;gap:9px;padding:12px 20px 9px;border-radius:32px 32px 0 0;background:linear-gradient(180deg,rgba(11,30,34,.62),rgba(5,17,22,.86));border-top:1px solid rgba(255,255,255,.1);backdrop-filter:blur(12px)}\n  .grab{width:38px;height:4px;border-radius:2px;background:rgba(255,255,255,.16)}\n  .wheel{position:relative;width:200px;height:200px}\n  .platter{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 32%,rgba(38,104,99,.4),rgba(7,30,34,.16) 66%,rgba(6,26,30,0) 100%);border:1px solid rgba(255,255,255,.08)}\n  .node{position:absolute;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:21px;font-weight:700;color:#0d3f3b;background:linear-gradient(180deg,#fffdf4,#f2e2c4);box-shadow:0 4px 0 var(--bevel),0 8px 14px rgba(0,0,0,.34),inset 0 1px 0 #fff;cursor:pointer;transition:transform .15s ease,box-shadow .2s ease,background .2s ease,color .2s ease}\n  .node:hover{transform:translateY(-1px)}\n  .node.peek{background:linear-gradient(180deg,#fffdf4,#f6e7c9);box-shadow:0 0 0 2px rgba(159,243,232,.6),0 0 20px rgba(80,214,201,.35),0 4px 0 var(--bevel)}\n  .shuffle{position:absolute;left:72px;top:72px;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;color:#d7ecea;background:rgba(9,30,34,.66);border:1px solid rgba(255,255,255,.18);cursor:pointer;transition:transform .35s ease,background .2s ease}\n  .shuffle .ic{width:21px;height:21px}\n  .shuffle:active{transform:rotate(180deg)}\n\n  .actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%}\n  .action{height:46px;border-radius:23px;display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(14,36,40,.62);border:1px solid rgba(255,255,255,.13);color:var(--cream);font-family:var(--ui);font-size:12.5px;font-weight:600;cursor:pointer;transition:background .2s ease,border-color .2s ease,transform .16s ease}\n  .action:hover{background:rgba(22,52,56,.78);border-color:rgba(159,243,232,.35)}\n  .action:active{transform:translateY(1px)}\n  .action .ic{width:17px;height:17px;color:var(--teal-lift)}\n  .action .price{font-size:11px;font-weight:700;color:#ffd790;padding-left:2px}\n\n  .tabs{position:relative;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 8px 13px;border-top:1px solid rgba(255,255,255,.07);background:rgba(3,13,18,.92)}\n  .tab{display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px 0;background:none;border:0;color:var(--muted);font-family:var(--ui);font-size:10.5px;font-weight:600;cursor:pointer;transition:color .18s ease}\n  .tab .ic{width:21px;height:21px}\n  .tab:hover{color:#cfe6e4}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG icon sprite\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol fill=\"none\" id=\"i-home\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M5 12l-2 0l9 -9l9 9l-2 0\"></path><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7\"></path><path d=\"M10 12h4v4h-4z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-book\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12z\"></path><path d=\"M19 16h-12a2 2 0 0 0 -2 2\"></path><path d=\"M9 8h6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-medal\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M9 3h6l3 7l-6 2l-6 -2z\"></path><path d=\"M12 12l-3 -9\"></path><path d=\"M15 11l-3 -8\"></path><path d=\"M12 19.5l-3 1.5l.5 -3.5l-2 -2l3 -.5l1.5 -3l1.5 3l3 .5l-2 2l.5 3.5z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-settings\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z\"></path><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path></symbol>\n<symbol id=\"i-star\" viewbox=\"0 0 24 24\"><path d=\"M12 3l2.47 6.1l6.56 .46l-5.04 4.24l1.59 6.39L12 16.7