    },
    "var_a2fe3e6edb28": {
      "type": "variant",
      "label": "Splash — Wordnest mark + loading, auto-advance",
      "parentId": "var_021fe7db8c37",
      "themeId": null,
      "rect": {
        "x": 1960,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  :root{\n    --cream:#fff8e7; --bevel:#d7c199; --teal-lift:#9ff3e8; --gold:#f5b83d; --muted:#8fa6a4;\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif; --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px}\n  .scrim{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 42%,rgba(6,26,30,.18),rgba(4,16,22,.72) 62%,rgba(3,11,16,.92))}\n\n  .stack{position:relative;display:flex;flex-direction:column;align-items:center;width:100%;padding:0 32px}\n\n  .emblem{position:relative;width:136px;height:136px;display:grid;place-items:center}\n  .halo{position:absolute;inset:-24px;border-radius:50%;background:radial-gradient(circle at 50% 50%,rgba(94,220,203,.24),rgba(15,118,110,.06) 58%,rgba(6,22,26,0) 76%)}\n  .orbit{position:absolute;inset:0;border-radius:50%;border:1px solid rgba(159,243,232,.16)}\n  .orbit2{position:absolute;inset:14px;border-radius:50%;border:1px dashed rgba(159,243,232,.1)}\n  .dot{position:absolute;width:7px;height:7px;border-radius:50%;background:rgba(255,248,231,.55)}\n  .d1{left:50%;top:-3px;margin-left:-3.5px}\n  .d2{left:50%;bottom:-3px;margin-left:-3.5px;opacity:.35}\n  .d3{top:50%;left:-3px;margin-top:-3.5px;opacity:.3}\n  .d4{top:50%;right:-3px;margin-top:-3.5px;opacity:.5}\n\n  .mark{position:relative;width:96px;height:96px;border-radius:24px;display:grid;place-items:center;font-family:var(--display);font-size:54px;font-weight:700;color:#0f4b46;background:linear-gradient(180deg,#fffdf5,#f5e8cb);box-shadow:0 6px 0 var(--bevel),0 20px 34px rgba(0,0,0,.45),inset 0 2px 0 #fff}\n  .mark::before{content:'';position:absolute;inset:5px;border-radius:19px;border:1px solid rgba(255,255,255,.7);opacity:.55}\n  .spark{position:absolute;top:-7px;right:-7px;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 30%,#fff3cf,#ffcf72 55%,#f5b83d);box-shadow:0 0 18px rgba(245,184,61,.7),0 2px 6px rgba(0,0,0,.4);color:#7a4d00}\n  .spark svg{width:14px;height:14px}\n\n  .wordmark{margin-top:26px;font-family:var(--display);font-size:35px;font-weight:700;letter-spacing:-.6px;color:var(--cream)}\n  .wordmark s{text-decoration:none;color:var(--gold)}\n  .descriptor{margin-top:8px;font-size:10px;font-weight:700;letter-spacing:.34em;text-transform:uppercase;color:rgba(159,243,232,.72)}\n  .quote{margin-top:26px;font-size:13px;font-weight:500;font-style:italic;color:rgba(231,242,243,.6);text-align:center}\n\n  .loader{margin-top:34px;width:100%;max-width:196px}\n  .track{position:relative;height:4px;border-radius:2px;background:rgba(255,255,255,.13);overflow:hidden}\n  .fill{position:absolute;inset:0 auto 0 0;width:62%;border-radius:2px;background:linear-gradient(90deg,#0f766e,#5fd8c9 62%,#f5b83d);box-shadow:0 0 12px rgba(95,216,201,.5)}\n  .loadlabel{margin-top:12px;display:flex;align-items:center;justify-content:center;gap:6px;font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}\n  .dotpulse{width:3px;height:3px;border-radius:50%;background:rgba(159,243,232,.7)}\n\n  .version{position:absolute;bottom:34px;left:0;right:0;text-align:center;font-size:11px;font-weight:500;color:rgba(147,170,168,.75);letter-spacing:.03em}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG sprite sheet containing icon symbols\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol id=\"i-spark\" viewbox=\"0 0 24 24\"><path d=\"M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2z\" fill=\"currentColor\"></path></symbol>\n</svg>\n<div class=\"screen\" data-kid=\"2\" data-name=\"splash screen layout container\">\n<svg aria-hidden=\"true\" class=\"scene\" data-kid=\"2-1\" data-name=\"scenic night-lake landscape SVG background\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 390 844\">\n<defs>\n<lineargradient id=\"sky\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#04141a\"></stop><stop offset=\".3\" stop-color=\"#0b2d34\"></stop><stop offset=\".46\" stop-color=\"#1a4b4c\"></stop>\n<stop offset=\".56\" stop-color=\"#123437\"></stop><stop offset=\".72\" stop-color=\"#071c22\"></stop><stop offset=\"1\" stop-color=\"#03101a\"></stop>\n</lineargradient>\n<radialgradient cx=\"50%\" cy=\"50%\" id=\"mist\" r=\"50%\">\n<stop offset=\"0\" stop-color=\"#9ff3e8\" stop-opacity=\".3\"></stop><stop offset=\"1\" stop-color=\"#0f766e\" stop-opacity=\"0\"></stop>\n</radialgradient>\n<lineargradient id=\"water\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0b2c31\"></stop><stop offset=\"1\" stop-color=\"#02101a\"></stop></lineargradient>\n<filter height=\"220%\" id=\"soft\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"18\"></fegaussianblur></filter>\n<filter height=\"220%\" id=\"haze\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"34\"></fegaussianblur></filter>\n<symbol id=\"pine\" viewbox=\"0 0 16 40\"><path d=\"M8 0l5 11H3zM8 7l6 13H2zM8 15l7 15H1zM7 30h2v10H7z\"></path></symbol>\n</defs>\n<rect fill=\"url(#sky)\" height=\"844\" width=\"390\"></rect>\n<circle cx=\"195\" cy=\"330\" fill=\"url(#mist)\" r=\"210\"></circle>\n<path d=\"M0 300 L46 268 L88 296 L130 262 L178 296 L216 270 L264 300 L308 274 L352 302 L390 280 L390 470 L0 470 Z\" fill=\"#12383c\" opacity=\".6\"></path>\n<path d=\"M0 358 L38 334 L82 358 L124 330 L168 360 L206 336 L252 364 L296 340 L342 366 L390 344 L390 480 L0 480 Z\" fill=\"#08232a\"></path>\n<rect fill=\"url(#water)\" height=\"412\" width=\"390\" y=\"432\"></rect>\n<ellipse cx=\"195\" cy=\"470\" fill=\"#9ff3e8\" filter=\"url(#soft)\" opacity=\".07\" rx=\"200\" ry=\"20\"></ellipse>\n<ellipse cx=\"195\" cy=\"560\" fill=\"#8fd8c9\" filter=\"url(#soft)\" opacity=\".05\" rx=\"240\" ry=\"26\"></ellipse>\n<g fill=\"#031319\">\n<use height=\"65\" href=\"#pine\" width=\"26\" x=\"-8\" y=\"382\"></use>\n<use height=\"45\" href=\"#pine\" width=\"18\" x=\"14\" y=\"398\"></use>\n<use height=\"70\" href=\"#pine\" width=\"28\" x=\"358\" y=\"376\"></use>\n<use height=\"45\" href=\"#pine\" width=\"18\" x=\"340\" y=\"398\"></use>\n</g>\n<ellipse cx=\"195\" cy=\"410\" fill=\"#c9f2ea\" filter=\"url(#haze)\" opacity=\".07\" rx=\"230\" ry=\"30\"></ellipse>\n</svg>\n<div class=\"scrim\" data-kid=\"2-2\" data-name=\"radial vignette scrim overlay\"></div>\n<div class=\"stack\" data-kid=\"2-3\" data-name=\"centered content stack wrapper\">\n<div class=\"emblem\" data-kid=\"2-3-1\" data-name=\"logo emblem container with orbits\">\n<span class=\"halo\" data-kid=\"2-3-1-1\" data-name=\"radial glow halo behind logo\"></span>\n<span class=\"orbit\" data-kid=\"2-3-1-2\" data-name=\"solid circular orbit ring\"></span>\n<span class=\"orbit2\" data-kid=\"2-3-1-3\" data-name=\"dashed inner circular orbit ring\"></span>\n<span class=\"dot d1\" data-kid=\"2-3-1-4\" data-name=\"small orbit accent dot\"></span>\n<span class=\"dot d2\" data-kid=\"2-3-1-5\" data-name=\"small orbit accent dot\"></span>\n<span class=\"dot d3\" data-kid=\"2-3-1-6\" data-name=\"small orbit accent dot\"></span>\n<span class=\"dot d4\" data-kid=\"2-3-1-7\" data-name=\"small orbit accent dot\"></span>\n<span class=\"mark\" data-kid=\"2-3-1-8\" data-name=\"logo mark tile with letter\">W\n        <span class=\"spark\" data-kid=\"2-3-1-8-1\" data-name=\"gold spark badge on logo corner\"><svg data-kid=\"2-3-1-8-1-1\" data-name=\"sparkle four-point star icon\"><use href=\"#i-spark\"></use></svg></span>\n</span>\n</div>\n<div class=\"wordmark\" data-kid=\"2-3-2\" data-name=\"brand wordmark text\">Wordnest<s data-kid=\"2-3-2-1\" data-name=\"gold accent period in wordmark\">.</s></div>\n<div class=\"descriptor\" data-kid=\"2-3-3\" data-name=\"brand descriptor tagline text\">Zen word puzzle</div>\n<div class=\"quote\" data-kid=\"2-3-4\" data-name=\"italic tagline quote text\">“Take your time.”</div>\n<div class=\"loader\" data-kid=\"2-3-5\" data-name=\"loading progress section\">\n<div class=\"track\" data-kid=\"2-3-5-1\" data-name=\"progress track bar\"><div class=\"fill\" data-kid=\"2-3-5-1-1\" data-name=\"progress fill bar at 62%\"></div></div>\n<div class=\"loadlabel\" data-kid=\"2-3-5-2\" data-name=\"loading label with dots row\">\n<span class=\"dotpulse\" data-kid=\"2-3-5-2-1\" data-name=\"pulsing loading dot\"></span>\n<span class=\"dotpulse\" data-kid=\"2-3-5-2-2\" data-name=\"pulsing loading dot\" style=\"opacity:.7\"></span>\n<span class=\"dotpulse\" data-kid=\"2-3-5-2-3\" data-name=\"pulsing loading dot\" style=\"opacity:.4\"></span>\n<span data-kid=\"2-3-5-2-4\" data-name=\"loading status label text\" style=\"margin-left:4px\">Loading</span>\n</div>\n</div>\n</div>\n<div class=\"version\" data-kid=\"2-4\" data-name=\"version number text\">Version 1.0.0</div>\n</div>\n",
      "comments": [],
