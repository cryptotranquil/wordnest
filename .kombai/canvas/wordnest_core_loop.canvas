    "var_cd41e0715921": {
      "type": "variant",
      "label": "Level Complete — stars, coins, next level",
      "parentId": "var_a2fe3e6edb28",
      "themeId": null,
      "rect": {
        "x": 2450,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  :root{\n    --cream:#fff8e7; --bevel:#d7c199; --teal:#0f766e; --teal-lift:#9ff3e8; --gold:#f5b83d;\n    --text:#e7f2f3; --muted:#94aaa8; --glass:rgba(13,32,36,.56); --glass-line:rgba(255,255,255,.15);\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif; --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);color:var(--text);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px;filter:saturate(1) brightness(1.06)}\n  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,17,22,.46) 0%,rgba(5,22,26,.12) 34%,rgba(4,15,20,.28) 100%)}\n  .ic{width:22px;height:22px;flex:none}\n\n  .top{position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 16px 0}\n  .level{height:36px;padding:0 17px;display:flex;align-items:center;gap:7px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px);font-size:12.5px;letter-spacing:.03em;color:var(--muted);text-transform:uppercase}\n  .level b{font-family:var(--display);font-size:15px;font-weight:700;color:var(--cream);text-transform:none}\n  .coins{height:36px;padding:0 5px;display:flex;align-items:center;gap:9px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px)}\n  .coin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 2px 6px rgba(0,0,0,.45);color:#6b4500}\n  .coin .ic{width:13px;height:13px}\n  .amt{font-size:13.5px;font-weight:700;color:var(--cream)}\n  .plus{width:26px;height:26px;border:1px solid rgba(159,243,232,.32);border-radius:50%;background:rgba(128,213,203,.16);color:var(--teal-lift);font-size:15px;line-height:1;display:grid;place-items:center;cursor:pointer}\n\n  .sheet{margin-top:auto;display:flex;flex-direction:column;padding:16px 22px 18px;border-radius:30px 30px 0 0;background:linear-gradient(180deg,rgba(16,38,42,.9),rgba(8,24,28,.97));border-top:1px solid rgba(255,255,255,.12);box-shadow:0 -20px 50px rgba(0,0,0,.45);backdrop-filter:blur(20px)}\n  .sh{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}\n  .chap{display:flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;color:var(--muted)}\n  .sh .close{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);color:var(--text);cursor:pointer}\n  .sh .close .ic{width:15px;height:15px}\n\n  h1{margin:2px 0 0;font-family:'Quicksand',sans-serif;font-size:31px;font-weight:700;color:var(--cream);letter-spacing:-.3px;text-align:center}\n\n  .stars{display:flex;align-items:flex-start;justify-content:center;gap:26px;margin:18px 0 6px}\n  .star{display:flex;flex-direction:column;align-items:center;gap:8px;width:76px}\n  .disc{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;position:relative}\n  .disc .ic{width:26px;height:26px}\n  .on{background:radial-gradient(circle at 38% 28%,#ffe1a1,#f5b83d 62%,#c98a17);box-shadow:0 6px 16px rgba(245,184,61,.34),inset 0 1px 0 rgba(255,255,255,.7);color:#7a4d00}\n  .off{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.4);box-shadow:none}\n  .starlabel{font-size:11px;font-weight:700;letter-spacing:.02em;color:var(--cream);text-align:center}\n  .starlabel.dim{color:var(--muted);font-weight:600}\n\n  .reward{display:flex;align-items:center;gap:11px;margin-top:14px;padding:11px 13px;border-radius:18px;background:rgba(245,184,61,.09);border:1px solid rgba(245,184,61,.22)}\n  .reward .coinlg{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);color:#6b4500;box-shadow:inset 0 1px 0 rgba(255,255,255,.65)}\n  .reward .coinlg .ic{width:16px;height:16px}\n  .reward .rtxt{flex:1;font-size:12.5px;font-weight:600;color:#ffe4ae}\n  .reward .val{font-family:'Quicksand',sans-serif;font-size:17px;font-weight:700;color:#ffd27a}\n\n  .stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:12px;border-radius:16px;overflow:hidden;background:rgba(255,255,255,.08)}\n  .cell2{padding:11px 13px;background:rgba(9,26,30,.92)}\n  .klabel{font-size:9.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}\n  .kval{font-family:'Quicksand',sans-serif;font-size:17px;font-weight:700;color:var(--cream);margin-top:3px}\n\n  .bonusblock{margin-top:14px;padding:0 2px}\n  .brow{display:flex;align-items:center;justify-content:space-between;margin-bottom:7px}\n  .brow .l{display:flex;align-items:center;gap:7px;font-size:11.5px;font-weight:600;color:var(--text)}\n  .brow .l .ic{width:14px;height:14px;color:var(--gold)}\n  .brow .v{font-size:11.5px;font-weight:700;color:#ffd27a}\n  .track{height:5px;border-radius:3px;background:rgba(255,255,255,.1);overflow:hidden}\n  .fill{height:100%;width:80%;border-radius:3px;background:linear-gradient(90deg,#0f766e,#f5b83d)}\n\n  .primary{height:52px;margin-top:18px;border-radius:26px;border:0;display:flex;align-items:center;justify-content:center;gap:9px;background:linear-gradient(180deg,#189c90,#0c6b63);color:#f2fffd;font-family:var(--ui);font-size:14.5px;font-weight:700;letter-spacing:.01em;cursor:pointer;box-shadow:0 12px 26px rgba(6,104,96,.34),inset 0 1px 0 rgba(255,255,255,.22);transition:transform .16s ease,box-shadow .2s ease}\n  .primary:hover{transform:translateY(-1px);box-shadow:0 16px 30px rgba(6,104,96,.44),inset 0 1px 0 rgba(255,255,255,.24)}\n  .primary:active{transform:translateY(1px)}\n  .primary .ic{width:18px;height:18px}\n  .secondary{height:46px;margin-top:9px;border-radius:23px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.04);color:var(--text);font-family:var(--ui);font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background .2s ease,border-color .2s ease}\n  .secondary:hover{background:rgba(255,255,255,.09);border-color:rgba(159,243,232,.32)}\n\n  .quote{margin-top:14px;text-align:center;font-size:11.5px;font-style:italic;color:rgba(231,242,243,.58)}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG sprite symbol definitions\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol id=\"i-star\" viewbox=\"0 0 24 24\"><path d=\"M12 3l2.47 6.1l6.56 .46l-5.04 4.24l1.59 6.39L12 16.7L6.42 20.19l1.59 -6.39L2.97 9.56l6.56 -.46z\" fill=\"currentColor\"></path></symbol>\n<symbol fill=\"none\" id=\"i-book\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12z\"></path><path d=\"M19 16h-12a2 2 0 0 0 -2 2\"></path><path d=\"M9 8h6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-arrow-right\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M5 12l14 0\"></path><path d=\"M13 18l6 -6\"></path><path d=\"M13 6l6 6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-replay\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4\"></path><path d=\"M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4\"></path></symbol>\n<symbol fill=\"none\" id=\"i-notebook\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-11a1 1 0 0 1 -1 -1v-14a1 1 0 0 1 1 -1m3 0v18\"></path><path d=\"M13 8l2 0\"></path><path d=\"M13 12l2 0\"></path></symbol>\n<symbol fill=\"none\" id=\"i-x\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M18 6l-12 12\"></path><path d=\"M6 6l12 12\"></path></symbol>\n</svg>\n<div class=\"screen\" data-kid=\"2\" data-name=\"game screen layout container\">\n<svg aria-hidden=\"true\" class=\"scene\" data-kid=\"2-1\" data-name=\"background landscape scene illustration\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 390 844\">\n<defs>\n<lineargradient id=\"sky\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#04141a\"></stop><stop offset=\".34\" stop-color=\"#0a2b31\"></stop><stop offset=\".52\" stop-color=\"#124044\"></stop>\n<stop offset=\".62\" stop-color=\"#0b2b31\"></stop><stop offset=\".72\" stop-color=\"#061a20\"></stop><stop offset=\"1\" stop-color=\"#03101a\"></stop>\n</lineargradient>\n<lineargradient id=\"water\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0a2b30\"></stop><stop offset=\"1\" stop-color=\"#03121a\"></stop></lineargradient>\n<filter height=\"220%\" id=\"soft\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"14\"></fegaussianblur></filter>\n<symbol id=\"pine\" viewbox=\"0 0 16 40\"><path d=\"M8 0l5 11H3zM8 7l6 13H2zM8 15l7 15H1zM7 30h2v10H7z\"></path></symbol>\n</defs>\n<rect fill=\"url(#sky)\" height=\"844\" width=\"390\"></rect>\n<path d=\"M0 322 L44 292 L86 318 L128 284 L176 316 L214 290 L262 320 L306 296 L350 322 L390 302 L390 470 L0 470 Z\" fill=\"#0e343b\" opacity=\".9\"></path>\n<path d=\"M0 366 L38 342 L82 364 L124 336 L168 366 L206 344 L252 370 L296 348 L342 372 L390 350 L390 480 L0 480 Z\" fill=\"#0a282f\"></path>\n<rect fill=\"url(#water)\" height=\"392\" width=\"390\" y=\"452\"></rect>\n<g fill=\"#04161c\">\n<use height=\"85\" href=\"#pine\" width=\"34\" x=\"-4\" y=\"367\"></use>\n<use height=\"70\" href=\"#pine\" width=\"28\" x=\"24\" y=\"382\"></use>\n<use height=\"60\" href=\"#pine\" width=\"24\" x=\"47\" y=\"392\"></use>\n<use height=\"55\" href=\"#pine\" width=\"22\" x=\"310\" y=\"397\"></use>\n<use height=\"70\" href=\"#pine\" width=\"28\" x=\"330\" y=\"382\"></use>\n<use height=\"60\" href=\"#pine\" width=\"24\" x=\"354\" y=\"392\"></use>\n<use height=\"50\" href=\"#pine\" width=\"20\" x=\"373\" y=\"402\"></use>\n</g>\n<ellipse cx=\"195\" cy=\"490\" fill=\"#c9f2ea\" filter=\"url(#soft)\" opacity=\".05\" rx=\"220\" ry=\"18\"></ellipse>\n</svg>\n<div class=\"scrim\" data-kid=\"2-2\" data-name=\"gradient darkening scrim overlay\"></div>\n<header class=\"top\" data-kid=\"2-3\" data-name=\"top status bar\">\n<div class=\"level\" data-kid=\"2-3-1\" data-name=\"level indicator pill\">Level <b data-kid=\"2-3-1-1\" data-name=\"level number text\">14</b></div>\n<div class=\"coins\" data-kid=\"2-3-2\" data-name=\"coins balance pill\">\n<span class=\"coin\" data-kid=\"2-3-2-1\" data-name=\"coins balance icon badge\"><svg class=\"ic\" data-kid=\"2-3-2-1-1\" data-name=\"star coin icon\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"amt\" data-kid=\"2-3-2-2\" data-name=\"coins balance amount text\">1,450</span>\n<button aria-label=\"Get more coins\" class=\"plus\" data-kid=\"2-3-2-3\" data-name=\"get more coins plus button\">+</button>\n</div>\n</header>\n<section aria-label=\"Level complete\" class=\"sheet\" data-kid=\"2-4\" data-name=\"level complete bottom sheet\">\n<div class=\"sh\" data-kid=\"2-4-1\" data-name=\"sheet header bar\">\n<span class=\"chap\" data-kid=\"2-4-1-1\" data-name=\"chapter title label\"><svg class=\"ic\" data-kid=\"2-4-1-1-1\" data-name=\"book category icon\" style=\"width:14px;height:14px\"><use href=\"#i-book\"></use></svg>Misty Lake</span>\n<button aria-label=\"Close\" class=\"close\" data-kid=\"2-4-1-2\" data-name=\"close button\"><svg class=\"ic\" data-kid=\"2-4-1-2-1\" data-name=\"close X icon\"><use href=\"#i-x\"></use></svg></button>\n</div>\n<h1 data-kid=\"2-4-2\" data-name=\"level complete headline\">Level complete</h1>\n<div class=\"stars\" data-kid=\"2-4-3\" data-name=\"star rating row\">\n<div class=\"star\" data-kid=\"2-4-3-1\" data-name=\"star rating column\">\n<span class=\"disc on\" data-kid=\"2-4-3-1-1\" data-name=\"lit star medallion\"><svg class=\"ic\" data-kid=\"2-4-3-1-1-1\" data-name=\"star rating icon\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"starlabel\" data-kid=\"2-4-3-1-2\" data-name=\"star category label\">Speed</span>\n</div>\n<div class=\"star\" data-kid=\"2-4-3-2\" data-name=\"star rating column\">\n<span class=\"disc on\" data-kid=\"2-4-3-2-1\" data-name=\"lit star medallion\"><svg class=\"ic\" data-kid=\"2-4-3-2-1-1\" data-name=\"star rating icon\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"starlabel\" data-kid=\"2-4-3-2-2\" data-name=\"star category label\">Mastery</span>\n</div>\n<div class=\"star\" data-kid=\"2-4-3-3\" data-name=\"star rating column\">\n<span class=\"disc off\" data-kid=\"2-4-3-3-1\" data-name=\"dimmed star medallion\"><svg class=\"ic\" data-kid=\"2-4-3-3-1-1\" data-name=\"star rating icon\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"starlabel dim\" data-kid=\"2-4-3-3-2\" data-name=\"dimmed star category label\">Lexicon</span>\n</div>\n</div>\n<div class=\"reward\" data-kid=\"2-4-4\" data-name=\"coins earned reward row\">\n<span class=\"coinlg\" data-kid=\"2-4-4-1\" data-name=\"coin icon badge\"><svg class=\"ic\" data-kid=\"2-4-4-1-1\" data-name=\"coin star icon\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"rtxt\" data-kid=\"2-4-4-2\" data-name=\"reward description text\">Coins earned</span>\n<span class=\"val\" data-kid=\"2-4-4-3\" data-name=\"reward value text\">+25</span>\n</div>\n<div class=\"stats\" data-kid=\"2-4-5\" data-name=\"stats grid container\">\n<div class=\"cell2\" data-kid=\"2-4-5-1\" data-name=\"words stat cell\">\n<div class=\"klabel\" data-kid=\"2-4-5-1-1\" data-name=\"stat category label\">Words</div>\n<div class=\"kval\" data-kid=\"2-4-5-1-2\" data-name=\"words stat value text\">4 / 4</div>\n</div>\n<div class=\"cell2\" data-kid=\"2-4-5-2\" data-name=\"precision stat cell\">\n<div class=\"klabel\" data-kid=\"2-4-5-2-1\" data-name=\"stat category label\">Precision</div>\n<div class=\"kval\" data-kid=\"2-4-5-2-2\" data-name=\"precision stat value text\">100%</div>\n</div>\n</div>\n<div class=\"bonusblock\" data-kid=\"2-4-6\" data-name=\"bonus words progress block\">\n<div class=\"brow\" data-kid=\"2-4-6-1\" data-name=\"bonus words progress header row\">\n<span class=\"l\" data-kid=\"2-4-6-1-1\" data-name=\"bonus words label\"><svg class=\"ic\" data-kid=\"2-4-6-1-1-1\" data-name=\"notebook progress icon\"><use href=\"#i-notebook\"></use></svg>Bonus words</span>\n<span class=\"v\" data-kid=\"2-4-6-1-2\" data-name=\"bonus words count text\">4 / 5</span>\n</div>\n<div class=\"track\" data-kid=\"2-4-6-2\" data-name=\"bonus progress track\"><div class=\"fill\" data-kid=\"2-4-6-2-1\" data-name=\"bonus progress fill bar\"></div></div>\n</div>\n<button class=\"primary\" data-kid=\"2-4-7\" data-name=\"primary next level call-to-action button\">\n      Next level\n      <svg class=\"ic\" data-kid=\"2-4-7-1\" data-name=\"forward arrow icon\"><use href=\"#i-arrow-right\"></use></svg>\n</button>\n<button class=\"secondary\" data-kid=\"2-4-8\" data-name=\"secondary replay button\">\n<svg class=\"ic\" data-kid=\"2-4-8-1\" data-name=\"replay circular arrow icon\" style=\"width:16px;height:16px\"><use href=\"#i-replay\"></use></svg>\n      Replay\n    </button>\n<p class=\"quote\" data-kid=\"2-4-9\" data-name=\"decorative quote text\">“A quiet mind discovers every answer.”</p>\n</section>\n</div>\n",
