=\"2-5-3-1\" data-name=\"turntable platter backdrop\"></div>\n<button aria-label=\"Letter T, last played\" class=\"node peek\" data-kid=\"2-5-3-2\" data-name=\"letter node T (previewed)\" style=\"left:76px;top:4px\">T</button>\n<button aria-label=\"Letter I\" class=\"node\" data-kid=\"2-5-3-3\" data-name=\"letter node I\" style=\"left:138.5px;top:40px\">I</button>\n<button aria-label=\"Letter M\" class=\"node\" data-kid=\"2-5-3-4\" data-name=\"letter node M\" style=\"left:138.5px;top:112px\">M</button>\n<button aria-label=\"Letter B\" class=\"node\" data-kid=\"2-5-3-5\" data-name=\"letter node B\" style=\"left:76px;top:148px\">B</button>\n<button aria-label=\"Letter E\" class=\"node\" data-kid=\"2-5-3-6\" data-name=\"letter node E\" style=\"left:13.5px;top:112px\">E</button>\n<button aria-label=\"Letter R\" class=\"node\" data-kid=\"2-5-3-7\" data-name=\"letter node R\" style=\"left:13.5px;top:40px\">R</button>\n<button aria-label=\"Shuffle letters\" class=\"shuffle\" data-kid=\"2-5-3-8\" data-name=\"shuffle letters button\"><svg class=\"ic\" data-kid=\"2-5-3-8-1\" data-name=\"shuffle icon\"><use href=\"#i-shuffle\"></use></svg></button>\n</div>\n<div class=\"actions\" data-kid=\"2-5-4\" data-name=\"action buttons row\">\n<button class=\"action\" data-kid=\"2-5-4-1\" data-name=\"hint action button\"><svg class=\"ic\" data-kid=\"2-5-4-1-1\" data-name=\"lightbulb hint icon\"><use href=\"#i-bulb\"></use></svg>Hint<span class=\"price\" data-kid=\"2-5-4-1-2\" data-name=\"hint coin price\">100</span></button>\n<button class=\"action\" data-kid=\"2-5-4-2\" data-name=\"target action button\"><svg class=\"ic\" data-kid=\"2-5-4-2-1\" data-name=\"focus target icon\"><use href=\"#i-focus\"></use></svg>Target<span class=\"price\" data-kid=\"2-5-4-2-2\" data-name=\"target coin price\">150</span></button>\n</div>\n</section>\n<nav aria-label=\"Main\" class=\"tabs\" data-kid=\"2-6\" data-name=\"bottom tab navigation\">\n<button class=\"tab\" data-kid=\"2-6-1\" data-name=\"Home navigation tab\"><svg class=\"ic\" data-kid=\"2-6-1-1\" data-name=\"home icon\"><use href=\"#i-home\"></use></svg>Home</button>\n<button class=\"tab\" data-kid=\"2-6-2\" data-name=\"Chapters navigation tab\"><svg class=\"ic\" data-kid=\"2-6-2-1\" data-name=\"book icon\"><use href=\"#i-book\"></use></svg>Chapters</button>\n<button class=\"tab\" data-kid=\"2-6-3\" data-name=\"Missions navigation tab\"><svg class=\"ic\" data-kid=\"2-6-3-1\" data-name=\"medal icon\"><use href=\"#i-medal\"></use></svg>Missions</button>\n<button class=\"tab\" data-kid=\"2-6-4\" data-name=\"Settings navigation tab\"><svg class=\"ic\" data-kid=\"2-6-4-1\" data-name=\"settings gear icon\"><use href=\"#i-settings\"></use></svg>Settings</button>\n</nav>\n</div>\n",
