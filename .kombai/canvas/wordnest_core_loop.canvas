        "h": 0
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  :root{\n    --cream:#fff8e7; --bevel:#d7c199; --teal:#0f766e; --teal-lift:#9ff3e8; --gold:#f5b83d;\n    --text:#e7f2f3; --muted:#94aaa8; --glass:rgba(13,32,36,.56); --glass-line:rgba(255,255,255,.15);\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif; --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);color:var(--text);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px}\n  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,17,22,.82) 0%,rgba(6,24,29,.3) 22%,rgba(5,22,26,.42) 55%,rgba(4,15,20,.92) 90%)}\n  .ic{width:22px;height:22px;flex:none}\n\n  /* brand row */\n  .brandrow{position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 16px 0}\n  .brand{display:flex;align-items:center;gap:9px}\n  .mark{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-family:var(--display);font-size:20px;font-weight:700;color:#12504b;background:linear-gradient(180deg,#fffdf4,#f4e6c8);box-shadow:0 3px 0 var(--bevel),0 6px 12px rgba(0,0,0,.35),inset 0 1px 0 #fff;position:relative}\n  .mark::after{content:'';position:absolute;top:-3px;right:-3px;width:8px;height:8px;border-radius:50%;background:var(--gold);box-shadow:0 0 9px rgba(245,184,61,.85)}\n  .wordmark{font-family:var(--display);font-size:18px;font-weight:700;letter-spacing:-.2px;color:var(--cream)}\n  .wordmark s{text-decoration:none;color:var(--gold)}\n  .coins{height:36px;padding:0 5px;display:flex;align-items:center;gap:9px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);backdrop-filter:blur(16px)}\n  .coin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),0 2px 6px rgba(0,0,0,.45);color:#6b4500}\n  .coin .ic{width:13px;height:13px}\n  .amt{font-size:13.5px;font-weight:700;color:var(--cream)}\n  .plus{width:26px;height:26px;border:1px solid rgba(159,243,232,.32);border-radius:50%;background:rgba(128,213,203,.16);color:var(--teal-lift);font-size:15px;line-height:1;display:grid;place-items:center;cursor:pointer;transition:background .18s ease,transform .18s ease}\n  .plus:active{transform:scale(.92)}\n\n  /* continue block */\n  .hero{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 16px}\n  .chapter{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.02em}\n  .chapter b{color:var(--cream);font-weight:700}\n  .chapter .ic{width:15px;height:15px;color:var(--teal-lift)}\n\n  .playbtn{position:relative;margin-top:22px;width:188px;height:188px;border-radius:50%;border:0;cursor:pointer;background:radial-gradient(circle at 50% 22%,#2fb0a1,#0d6a62 56%,#09504b);box-shadow:0 22px 46px rgba(6,104,96,.44),inset 0 2px 0 rgba(255,255,255,.26),inset 0 -12px 28px rgba(0,0,0,.34),0 0 0 1px rgba(159,243,232,.3);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:transform .18s ease,box-shadow .25s ease}\n  .playbtn:hover{transform:translateY(-2px);box-shadow:0 22px 48px rgba(6,104,96,.5),inset 0 2px 0 rgba(255,255,255,.26),inset 0 -10px 24px rgba(0,0,0,.32),0 0 0 1px rgba(159,243,232,.42)}\n  .playbtn:active{transform:scale(.97)}\n  .playbtn .ic{width:26px;height:26px;color:#dffaf5;opacity:.9}\n  .playbtn .label{font-family:var(--display);font-size:26px;font-weight:700;color:#f2fffd;letter-spacing:.06em}\n  .ring{position:absolute;inset:-9px;border-radius:50%;border:1px solid rgba(159,243,232,.16);pointer-events:none}\n  .ring2{position:absolute;inset:-20px;border-radius:50%;border:1px solid rgba(159,243,232,.07);pointer-events:none}\n\n  .levelrow{display:flex;align-items:center;gap:10px;margin-top:14px}\n  .levelchip{height:26px;padding:0 11px;display:flex;align-items:center;border-radius:13px;background:rgba(9,28,32,.62);border:1px solid rgba(255,255,255,.13);font-size:11.5px;font-weight:700;color:var(--cream);letter-spacing:.02em}\n  .stars{display:flex;align-items:center;gap:3px}\n  .stars .ic{width:14px;height:14px;color:var(--gold)}\n  .stars .off{color:rgba(255,255,255,.22)}\n\n  .progresswrap{width:100%;max-width:280px;margin-top:14px}\n  .progresslabel{display:flex;align-items:center;justify-content:space-between;font-size:10.5px;font-weight:600;color:var(--muted);margin-bottom:6px;letter-spacing:.02em}\n  .progresslabel b{color:var(--cream);font-weight:700}\n  .track{height:5px;border-radius:3px;background:rgba(255,255,255,.11);overflow:hidden}\n  .fill{height:100%;width:75%;border-radius:3px;background:linear-gradient(90deg,#0f766e,#5fd8c9 70%,#f5b83d)}\n\n  /* today panel */\n  .today{position:relative;margin:0 16px 12px;border-radius:24px;background:rgba(10,28,32,.62);border:1px solid var(--glass-line);backdrop-filter:blur(18px);overflow:hidden}\n  .th{display:flex;align-items:center;justify-content:space-between;padding:13px 16px 9px}\n  .th h2{margin:0;font-family:var(--display);font-size:15px;font-weight:700;color:var(--cream);letter-spacing:.01em}\n  .th span{font-size:10.5px;font-weight:600;color:var(--muted)}\n  .row{display:flex;align-items:center;gap:12px;padding:11px 14px;border-top:1px solid rgba(255,255,255,.07);background:none;border-left:0;border-right:0;border-bottom:0;width:100%;text-align:left;cursor:pointer;font-family:var(--ui);transition:background .2s ease}\n  .row:hover{background:rgba(255,255,255,.04)}\n  .rico{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:rgba(159,243,232,.1);color:var(--teal-lift);flex:none}\n  .rico.gold{background:rgba(245,184,61,.13);color:#ffce75}\n  .rico .ic{width:18px;height:18px}\n  .rmeta{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}\n  .rtitle{display:block;font-size:13px;font-weight:700;color:var(--text);line-height:1.3}\n  .rsub{display:block;font-size:11px;font-weight:500;color:var(--muted);line-height:1.3}\n  .rsub b{color:#bfe9e3;font-weight:600}\n  .act{height:30px;padding:0 13px;border-radius:15px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:var(--text);font-family:var(--ui);font-size:11.5px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:5px;transition:background .2s ease,border-color .2s ease}\n  .act .ic{width:12px;height:12px}\n  .act.solid{background:linear-gradient(180deg,#ffcf72,#f5b83d);border-color:transparent;color:#3d2600;box-shadow:0 3px 10px rgba(245,184,61,.3)}\n  .act:hover{border-color:rgba(159,243,232,.4)}\n\n  .spacer{flex:1;min-height:8px}\n\n  .tabs{position:relative;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 8px 13px;border-top:1px solid rgba(255,255,255,.08);background:linear-gradient(180deg,rgba(5,20,25,.55),rgba(3,13,18,.94));backdrop-filter:blur(18px)}\n  .tab{display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px 0;background:none;border:0;color:var(--muted);font-family:var(--ui);font-size:10.5px;font-weight:600;cursor:pointer;transition:color .18s ease}\n  .tab .ic{width:21px;height:21px}\n  .tab:hover{color:#cfe6e4}\n  .tab[aria-current=\"page\"]{color:var(--teal-lift)}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"SVG icon sprite sheet (hidden symbol definitions)\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol fill=\"none\" id=\"i-home\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M5 12l-2 0l9 -9l9 9l-2 0\"></path><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7\"></path><path d=\"M10 12h4v4h-4z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-book\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12z\"></path><path d=\"M19 16h-12a2 2 0 0 0 -2 2\"></path><path d=\"M9 8h6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-medal\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M9 3h6l3 7l-6 2l-6 -2z\"></path><path d=\"M12 12l-3 -9\"></path><path d=\"M15 11l-3 -8\"></path><path d=\"M12 19.5l-3 1.5l.5 -3.5l-2 -2l3 -.5l1.5 -3l1.5 3l3 .5l-2 2l.5 3.5z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-settings\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z\"></path><path d=\"M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0\"></path></symbol>\n<symbol id=\"i-star\" viewbox=\"0 0 24 24\"><path d=\"M12 3l2.47 6.1l6.56 .46l-5.04 4.24l1.59 6.39L12 16.7L6.42 20.19l1.59 -6.39L2.97 9.56l6.56 -.46z\" fill=\"currentColor\"></path></symbol>\n<symbol id=\"i-play\" viewbox=\"0 0 24 24\"><path d=\"M8 5.2l11 6.8l-11 6.8z\" fill=\"currentColor\"></path></symbol>\n<symbol fill=\"none\" id=\"i-calendar\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M4 5m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z\"></path><path d=\"M16 3l0 4\"></path><path d=\"M8 3l0 4\"></path><path d=\"M4 11l16 0\"></path><path d=\"M8 15h2v2h-2z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-gift\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M3 8m0 1a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z\"></path><path d=\"M12 8l0 13\"></path><path d=\"M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7\"></path><path d=\"M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5\"></path></symbol>\n<symbol fill=\"none\" id=\"i-list\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.9\" viewbox=\"0 0 24 24\"><path d=\"M9 6l11 0\"></path><path d=\"M9 12l11 0\"></path><path d=\"M9 18l11 0\"></path><path d=\"M5 6l0 .01\"></path><path d=\"M5 12l0 .01\"></path><path d=\"M5 18l0 .01\"></path></symbol>\n</svg>\n<div class=\"screen\" data-kid=\"2\" data-name=\"mobile app screen container\">\n<svg aria-hidden=\"true\" class=\"scene\" data-kid=\"2-1\" data-name=\"decorative background scene illustration (misty lake mountains and water)\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 390 844\">\n<defs>\n<lineargradient id=\"sky\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\">\n<stop offset=\"0\" stop-color=\"#04141a\"></stop><stop offset=\".32\" stop-color=\"#0a2b31\"></stop><stop offset=\".5\" stop-color=\"#124044\"></stop>\n<stop offset=\".6\" stop-color=\"#0b2b31\"></stop><stop offset=\".72\" stop-color=\"#061a20\"></stop><stop offset=\"1\" stop-color=\"#03101a\"></stop>\n</lineargradient>\n<radialgradient cx=\"50%\" cy=\"50%\" id=\"glow\" r=\"50%\">\n<stop offset=\"0\" stop-color=\"#8fe6d8\" stop-opacity=\".28\"></stop><stop offset=\"1\" stop-color=\"#0f766e\" stop-opacity=\"0\"></stop>\n</radialgradient>\n<lineargradient id=\"water\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0a2b30\"></stop><stop offset=\"1\" stop-color=\"#03121a\"></stop></lineargradient>\n<filter height=\"220%\" id=\"soft\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"14\"></fegaussianblur></filter>\n<filter height=\"220%\" id=\"haze\" width=\"160%\" x=\"-30%\" y=\"-60%\"><fegaussianblur stddeviation=\"28\"></fegaussianblur></filter>\n<symbol id=\"pine\" viewbox=\"0 0 16 40\"><path d=\"M8 0l5 11H3zM8 7l6 13H2zM8 15l7 15H1zM7 30h2v10H7z\"></path></symbol>\n</defs>\n<rect fill=\"url(#sky)\" height=\"844\" width=\"390\"></rect>\n<circle cx=\"195\" cy=\"250\" fill=\"url(#glow)\" r=\"200\"></circle>\n<path d=\"M0 336 L44 306 L86 332 L128 298 L176 330 L214 304 L262 334 L306 310 L350 336 L390 316 L390 470 L0 470 Z\" fill=\"#0e343b\" opacity=\".85\"></path>\n<path d=\"M0 392 L38 368 L82 390 L124 362 L168 392 L206 370 L252 396 L296 374 L342 398 L390 376 L390 480 L0 480 Z\" fill=\"#0a282f\"></path>\n<rect fill=\"url(#water)\" height=\"392\" width=\"390\" y=\"452\"></rect>\n<g fill=\"#04161c\">\n<use height=\"75\" href=\"#pine\" width=\"30\" x=\"-6\" y=\"380\"></use>\n<use height=\"55\" href=\"#pine\" width=\"22\" x=\"20\" y=\"398\"></use>\n<use height=\"40\" href=\"#pine\" width=\"16\" x=\"40\" y=\"410\"></use>\n<use height=\"65\" href=\"#pine\" width=\"26\" x=\"352\" y=\"386\"></use>\n<use height=\"45\" href=\"#pine\" width=\"18\" x=\"372\" y=\"404\"></use>\n</g>\n<ellipse cx=\"195\" cy=\"500\" fill=\"#c9f2ea\" filter=\"url(#soft)\" opacity=\".06\" rx=\"220\" ry=\"18\"></ellipse>\n<ellipse cx=\"195\" cy=\"620\" fill=\"#8fd8c9\" filter=\"url(#soft)\" opacity=\".05\" rx=\"260\" ry=\"24\"></ellipse>\n</svg>\n<div class=\"scrim\" data-kid=\"2-2\" data-name=\"scrim overlay for legibility\"></div>\n<div class=\"brandrow\" data-kid=\"2-3\" data-name=\"brand header row\">\n<div class=\"brand\" data-kid=\"2-3-1\" data-name=\"brand logo lockup\">\n<span class=\"mark\" data-kid=\"2-3-1-1\" data-name=\"brand monogram tile with accent dot\">W</span>\n<span class=\"wordmark\" data-kid=\"2-3-1-2\" data-name=\"brand wordmark\">Wordnest<s data-kid=\"2-3-1-2-1\" data-name=\"brand wordmark accent period\">.</s></span>\n</div>\n<div class=\"coins\" data-kid=\"2-3-2\" data-name=\"coin balance pill\">\n<span class=\"coin\" data-kid=\"2-3-2-1\" data-name=\"coin badge icon\"><svg class=\"ic\" data-kid=\"2-3-2-1-1\" data-name=\"star icon (coin marker)\"><use href=\"#i-star\"></use></svg></span>\n<span class=\"amt\" data-kid=\"2-3-2-2\" data-name=\"coin amount display (1\">1,450</span>\n<button aria-label=\"Get more coins\" class=\"plus\" data-kid=\"2-3-2-3\" data-name=\"add-coins plus button\">+</button>\n</div>\n</div>\n<main class=\"hero\" data-kid=\"2-4\" data-name=\"hero / continue playing section\">\n<div class=\"chapter\" data-kid=\"2-4-1\" data-name=\"chapter breadcrumb with level name\">\n<svg class=\"ic\" data-kid=\"2-4-1-1\" data-name=\"book icon\"><use href=\"#i-book\"></use></svg>\n<span data-kid=\"2-4-1-2\" data-name=\"chapter label (Chapter 2)\">Chapter 2</span>\n<b data-kid=\"2-4-1-3\" data-name=\"level title (Misty Lake)\">Misty Lake</b>\n</div>\n<button aria-label=\"Play level 14\" class=\"playbtn\" data-kid=\"2-4-2\" data-name=\"large circular play button\">\n<svg class=\"ic\" data-kid=\"2-4-2-1\" data-name=\"play triangle icon\"><use href=\"#i-play\"></use></svg>\n<span class=\"label\" data-kid=\"2-4-2-2\" data-name=\"play button label text\">PLAY</span>\n<span class=\"ring\" data-kid=\"2-4-2-3\" data-name=\"decorative outer ring accent\"></span>\n<span class=\"ring2\" data-kid=\"2-4-2-4\" data-name=\"decorative second outer ring\"></span>\n</button>\n<div class=\"levelrow\" data-kid=\"2-4-3\" data-name=\"level indicator row (chip + stars)\">\n<span class=\"levelchip\" data-kid=\"2-4-3-1\" data-name=\"level chip (Level 14)\">Level 14</span>\n<span aria-label=\"Two of three stars earned on level 13\" class=\"stars\" data-kid=\"2-4-3-2\" data-name=\"earned stars rating group\">\n<svg class=\"ic\" data-kid=\"2-4-3-2-1\" data-name=\"earned star (golden)\"><use href=\"#i-star\"></use></svg>\n<svg class=\"ic\" data-kid=\"2-4-3-2-2\" data-name=\"earned star (golden)\"><use href=\"#i-star\"></use></svg>\n<svg class=\"ic off\" data-kid=\"2-4-3-2-3\" data-name=\"unearned star (muted)\"><use href=\"#i-star\"></use></svg>\n</span>\n</div>\n<div class=\"progresswrap\" data-kid=\"2-4-4\" data-name=\"chapter progress section\">\n<div class=\"progresslabel\" data-kid=\"2-4-4-1\" data-name=\"progress label row with count\"><span data-kid=\"2-4-4-1-1\" data-name=\"progress label (Levels cleared)\">Levels cleared</span><span data-kid=\"2-4-4-1-2\" data-name=\"progress count span (6 of 8)\"><b data-kid=\"2-4-4-1-2-1\" data-name=\"cleared level count (6)\">6</b> of 8</span></div>\n<div class=\"track\" data-kid=\"2-4-4-2\" data-name=\"progress track\"><div class=\"fill\" data-kid=\"2-4-4-2-1\" data-name=\"progress fill bar at 75%\"></div></div>\n</div>\n</main>\n<section class=\"today\" data-kid=\"2-5\" data-name=\"today's tasks card\">\n<div class=\"th\" data-kid=\"2-5-1\" data-name=\"today card header\">\n<h2 data-kid=\"2-5-1-1\" data-name=\"today card title\">Today</h2>\n<span data-dynamic=\"true\" data-kid=\"2-5-1-2\" data-name=\"reset countdown label\" data-reason=\"countdown text is reinitialized by a timer script\">Resets in 6h</span>\n</div>\n<div class=\"row\" data-kid=\"2-5-2\" data-name=\"daily puzzle task row\">\n<span class=\"rico\" data-kid=\"2-5-2-1\" data-name=\"daily puzzle icon tile (calendar)\"><svg class=\"ic\" data-kid=\"2-5-2-1-1\" data-name=\"calendar icon\"><use href=\"#i-calendar\"></use></svg></span>\n<span class=\"rmeta\" data-kid=\"2-5-2-2\" data-name=\"task metadata block\">\n<span class=\"rtitle\" data-kid=\"2-5-2-2-1\" data-name=\"task title (Daily puzzle)\">Daily puzzle</span>\n<span class=\"rsub\" data-kid=\"2-5-2-2-2\" data-name=\"task subtitle (Pine Vista #42)\">Pine Vista #42</span>\n</span>\n<button class=\"act\" data-kid=\"2-5-2-3\" data-name=\"action button (Play)\">Play</button>\n</div>\n<div class=\"row\" data-kid=\"2-5-3\" data-name=\"daily gift task row\">\n<span class=\"rico gold\" data-kid=\"2-5-3-1\" data-name=\"gift icon tile (gold)\"><svg class=\"ic\" data-kid=\"2-5-3-1-1\" data-name=\"gift icon\"><use href=\"#i-gift\"></use></svg></span>\n<span class=\"rmeta\" data-kid=\"2-5-3-2\" data-name=\"gift metadata block\">\n<span class=\"rtitle\" data-kid=\"2-5-3-2-1\" data-name=\"gift title\">Gift</span>\n<span class=\"rsub\" data-kid=\"2-5-3-2-2\" data-name=\"gift sub text (Day 4 of 7)\">Day <b data-kid=\"2-5-3-2-2-1\" data-name=\"gift day count (4)\">4</b> of 7</span>\n</span>\n<button class=\"act solid\" data-kid=\"2-5-3-3\" data-name=\"claim gift action button\">Claim</button>\n</div>\n<div class=\"row\" data-kid=\"2-5-4\" data-name=\"missions task row\">\n<span class=\"rico\" data-kid=\"2-5-4-1\" data-name=\"missions icon tile (medal)\"><svg class=\"ic\" data-kid=\"2-5-4-1-1\" data-name=\"medal icon\"><use href=\"#i-medal\"></use></svg></span>\n<span class=\"rmeta\" data-kid=\"2-5-4-2\" data-name=\"missions metadata block\">\n<span class=\"rtitle\" data-kid=\"2-5-4-2-1\" data-name=\"missions title\">Missions</span>\n<span class=\"rsub\" data-kid=\"2-5-4-2-2\" data-name=\"missions progress sub text (2 of 3)\">2 of 3 complete</span>\n</span>\n<button class=\"act\" data-kid=\"2-5-4-3\" data-name=\"view missions action button\">View</button>\n</div>\n</section>\n<nav aria-label=\"Main\" class=\"tabs\" data-kid=\"2-6\" data-name=\"bottom tab navigation\">\n<button aria-current=\"page\" class=\"tab\" data-kid=\"2-6-1\" data-name=\"home tab button (active)\"><svg class=\"ic\" data-kid=\"2-6-1-1\" data-name=\"home icon\"><use href=\"#i-home\"></use></svg>Home</button>\n<button class=\"tab\" data-kid=\"2-6-2\" data-name=\"chapters tab button\"><svg class=\"ic\" data-kid=\"2-6-2-1\" data-name=\"book icon\"><use href=\"#i-book\"></use></svg>Chapters</button>\n<button class=\"tab\" data-kid=\"2-6-3\" data-name=\"missions tab button\"><svg class=\"ic\" data-kid=\"2-6-3-1\" data-name=\"medal icon\"><use href=\"#i-medal\"></use></svg>Missions</button>\n<button class=\"tab\" data-kid=\"2-6-4\" data-name=\"settings tab button\"><svg class=\"ic\" data-kid=\"2-6-4-1\" data-name=\"settings gear icon\"><use href=\"#i-settings\"></use></svg>Settings</button>\n</nav>\n</div>\n",
