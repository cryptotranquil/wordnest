    "var_211fd843bbc2": {
      "type": "variant",
      "label": "Tutorial — Level 1 coach marks over the wheel",
      "parentId": "var_cd41e0715921",
      "themeId": null,
      "rect": {
        "x": 2940,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  :root{\n    --cream:#fff8e7; --bevel:#d7c199; --teal-lift:#9ff3e8; --gold:#f5b83d;\n    --text:#e7f2f3; --muted:#94aaa8; --glass:rgba(13,32,36,.56); --glass-line:rgba(255,255,255,.15);\n    --display:'Quicksand','Trebuchet MS','Segoe UI',sans-serif; --ui:'Plus Jakarta Sans','Segoe UI',sans-serif;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:#04121a;font-family:var(--ui);color:var(--text);display:flex;justify-content:center}\n  .screen{position:relative;width:390px;height:844px;overflow:hidden;display:flex;flex-direction:column;isolation:isolate;background:#05161a}\n  .scene{position:absolute;inset:0;width:390px;height:844px}\n  .scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(4,17,22,.86) 0%,rgba(5,22,27,.3) 16%,rgba(5,22,26,.36) 52%,rgba(4,15,20,.8) 90%)}\n  .ic{width:22px;height:22px;flex:none}\n\n  .top{position:relative;display:flex;align-items:center;justify-content:space-between;padding:16px 16px 0}\n  .level{height:36px;padding:0 17px;display:flex;align-items:center;gap:7px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line);font-size:12.5px;letter-spacing:.03em;color:var(--muted);text-transform:uppercase}\n  .level b{font-family:var(--display);font-size:15px;font-weight:700;color:var(--cream);text-transform:none}\n  .coins{height:36px;padding:0 5px;display:flex;align-items:center;gap:9px;border-radius:18px;background:var(--glass);border:1px solid var(--glass-line)}\n  .coin{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 32% 26%,#ffe6ac,#f5b83d 60%,#bf7f16);color:#6b4500;box-shadow:inset 0 1px 0 rgba(255,255,255,.65)}\n  .coin .ic{width:13px;height:13px}\n  .amt{font-size:13.5px;font-weight:700;color:var(--cream)}\n  .plus{width:26px;height:26px;border:1px solid rgba(159,243,232,.32);border-radius:50%;background:rgba(128,213,203,.16);color:var(--teal-lift);font-size:15px;display:grid;place-items:center;cursor:pointer}\n\n  .board{position:relative;flex:1;min-height:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;padding:0 16px}\n  .grid{display:grid;grid-template-columns:repeat(4,54px);gap:6px;justify-items:center}\n  .void{width:54px;height:54px}\n  .tile{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;font-family:var(--display);font-size:27px;font-weight:700;color:#0d4a46;background:linear-gradient(180deg,#fffdf4,#f7ebd1);box-shadow:0 4px 0 var(--bevel),0 10px 16px rgba(0,0,0,.33),inset 0 1px 0 #fff}\n  .slot{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;background:rgba(238,255,252,.055);border:1px solid rgba(255,255,255,.13)}\n  .slot i{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.24)}\n\n  .bonus{height:30px;display:flex;align-items:center;gap:8px;padding:0 11px;border-radius:15px;background:var(--glass);border:1px solid var(--glass-line);color:var(--text);font-family:var(--ui);font-size:12px;font-weight:600}\n  .bonus .ic{width:15px;height:15px;color:var(--teal-lift)}\n  .frac{font-size:11px;font-weight:700;color:#422d00;background:var(--gold);padding:2px 7px;border-radius:9px}\n\n  .play{position:relative;display:flex;align-items:center;justify-content:space-between;padding:2px 12px 6px}\n  .booster{display:flex;flex-direction:column;align-items:center;gap:6px;background:none;border:0;padding:0;font-family:var(--ui)}\n  .booster .disc{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:var(--glass);border:1px solid var(--glass-line);color:var(--cream);box-shadow:0 6px 18px rgba(0,0,0,.4)}\n  .cost{font-size:10.5px;font-weight:700;color:#ffd790}\n\n  .wheel{position:relative;width:232px;height:232px}\n  .platter{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 50% 32%,rgba(40,110,104,.42),rgba(7,30,34,.18) 66%,rgba(6,26,30,0) 100%);border:1px solid rgba(255,255,255,.08)}\n  .ribbon{position:absolute;inset:0;filter:drop-shadow(0 0 14px rgba(80,222,205,.6))}\n  .node{position:absolute;width:48px;height:48px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:21px;font-weight:700;color:#0d3f3b;background:linear-gradient(180deg,#fffdf4,#f2e2c4);box-shadow:0 4px 0 var(--bevel),0 8px 14px rgba(0,0,0,.35),inset 0 1px 0 #fff}\n  .node.on{color:#eafffb;background:linear-gradient(180deg,#12968b,#0b5f59);box-shadow:0 0 0 2px rgba(159,243,232,.55),0 0 30px rgba(70,214,198,.55),0 4px 0 #0c4c47}\n  .shuffle{position:absolute;left:88px;top:88px;width:56px;height:56px;border-radius:50%;display:grid;place-items:center;color:#d7ecea;background:rgba(9,30,34,.66);border:1px solid rgba(255,255,255,.18)}\n  .shuffle .ic{width:21px;height:21px}\n\n  .tabs{position:relative;display:grid;grid-template-columns:repeat(4,1fr);padding:7px 8px 13px;border-top:1px solid rgba(255,255,255,.08);background:rgba(3,13,18,.9)}\n  .tab{display:flex;flex-direction:column;align-items:center;gap:4px;padding:4px 0;background:none;border:0;color:var(--muted);font-family:var(--ui);font-size:10.5px;font-weight:600}\n  .tab .ic{width:21px;height:21px}\n\n  /* ---- coach mark overlay ---- */\n  .overlay{position:absolute;inset:0;z-index:6}\n  .spot{position:absolute;left:50%;top:656px;width:264px;height:264px;margin:-132px 0 0 -132px;border-radius:50%;box-shadow:0 0 0 2000px rgba(3,12,17,.8),0 0 0 1px rgba(159,243,232,.34);pointer-events:none}\n  .pulse{position:absolute;left:50%;top:656px;width:264px;height:264px;margin:-132px 0 0 -132px;border-radius:50%;border:1px solid rgba(159,243,232,.5);pointer-events:none}\n\n  .tip{position:absolute;left:50%;top:352px;width:304px;margin-left:-152px;padding:16px 16px 14px;border-radius:22px;background:linear-gradient(180deg,rgba(19,44,48,.98),rgba(10,28,32,.98));border:1px solid rgba(159,243,232,.28);box-shadow:0 22px 50px rgba(0,0,0,.55),inset 0 1px 0 rgba(255,255,255,.1)}\n  .tip::after{content:'';position:absolute;bottom:-8px;left:50%;margin-left:-8px;width:16px;height:16px;background:rgba(11,30,34,.98);border-right:1px solid rgba(159,243,232,.28);border-bottom:1px solid rgba(159,243,232,.28);transform:rotate(45deg);border-radius:0 0 4px 0}\n\n  .step{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}\n  .dots{display:flex;align-items:center;gap:5px}\n  .dots i{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.2)}\n  .dots i.on{width:18px;border-radius:3px;background:var(--teal-lift);box-shadow:0 0 10px rgba(159,243,232,.6)}\n  .stepno{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(159,243,232,.7)}\n\n  .tip h2{margin:0;font-family:var(--display);font-size:18px;font-weight:700;color:var(--cream);letter-spacing:-.1px}\n  .tip p{margin:6px 0 0;font-size:12.5px;line-height:1.5;font-weight:500;color:rgba(231,242,243,.72)}\n  .tipfoot{display:flex;align-items:center;justify-content:space-between;margin-top:14px}\n  .skip{background:none;border:0;padding:6px 2px;color:rgba(231,242,243,.55);font-family:var(--ui);font-size:12px;font-weight:600;cursor:pointer}\n  .skip:hover{color:var(--text)}\n  .next{height:38px;padding:0 18px;border-radius:19px;border:0;display:flex;align-items:center;gap:7px;background:linear-gradient(180deg,#189c90,#0c6b63);color:#f2fffd;font-family:var(--ui);font-size:12.5px;font-weight:700;cursor:pointer;box-shadow:0 8px 18px rgba(6,104,96,.36),inset 0 1px 0 rgba(255,255,255,.22);transition:transform .16s ease}\n  .next:hover{transform:translateY(-1px)}\n  .next .ic{width:14px;height:14px}\n</style>\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"inline SVG icon sprite\" height=\"0\" style=\"position:absolute\" width=\"0\">\n<symbol fill=\"none\" id=\"i-home\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M5 12l-2 0l9 -9l9 9l-2 0\"></path><path d=\"M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7\"></path><path d=\"M10 12h4v4h-4z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-book\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M19 4v16h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12z\"></path><path d=\"M19 16h-12a2 2 0 0 0 -2 2\"></path><path d=\"M9 8h6\"></path></symbol>\n<symbol fill=\"none\" id=\"i-medal\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M9 3h6l3 7l-6 2l-6 -2z\"></path><path d=\"M12 12l-3 -9\"></path><path d=\"M15 11l-3 -8\"></path><path d=\"M12 19.5l-3 1.5l.5 -3.5l-2 -2l3 -.5l1.5 -3l1.5 3l3 .5l-2 2l.5 3.5z\"></path></symbol>\n<symbol fill=\"none\" id=\"i-settings\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066z\" style=\"display:none\"></path></symbol>\n<symbol id=\"i-star\" viewbox=\"0 0 24 24\"><path d=\"M12 3l6l4.1 12l-5-3.6L4 18z\" fill=\"none\"></path><path d=\"M12 3l2.47 6.1l6.56 .46l-5.04 4.24l1.59 6.39L12 16.7L6.42 20.19l1.59 -6.39L2.97 9.56l6.56 -.46z\" fill=\"currentColor\"></path></symbol>\n<symbol fill=\"none\" id=\"i-notebook\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"M6 4h11a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-